                },
                {
                    "type": "list",
                    "items": [
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Atmosphere CFW</strong> — Custom firmware principale" },
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Hekate</strong> — Bootloader per gestire emuMMC" },
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Sigpatches</strong> — Per eseguire backup NSP/XCI" },
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>TegraRcmGUI</strong> — Software PC per iniettare payload" }
                    ]
                }
            ]
        }
