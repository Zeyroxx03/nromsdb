        { "id": "offline-files", "label": "Sezione 2 - Offline Files" },
        { "id": "lingua", "label": "Sezione 3 - Cambio Lingua" },
        { "id": "conclusione", "label": "Conclusione" }
    ],
    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "hero-image",
                    "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_justdance2025.webp",
                    "alt": "Just Dance 2025 su Nintendo Switch",
                    "caption": "Just Dance 2025 Edition"
                },
                {
                    "type": "text",
                    "content": "In questa guida vedremo come installare e preparare <strong>Just Dance 2025</strong> su Nintendo Switch."
                },
                
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Crediti immagine copertina",
                    "titleIcon": "bi-image-fill",
                    "content": "Cover originale: <code>gaming-cdn.com</code>."
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-clipboard-check-fill",
            "blocks": [
                {
                    "type": "download-list",
                    "title": "File da scaricare",
                    "titleIcon": "bi-telegram",
                    "items": [
                        {
                            "icon": "bi-disc-fill",
                            "iconColor": "#60a5fa",
                            "label": "Base",
                            "desc": "Gioco base Just Dance 2025",
                            "href": "https://t.me/c/2332511567/1862",
                            "highlight": "blue"
                        },
                        {
                            "icon": "bi-arrow-repeat",
                            "iconColor": "#22d3ee",
                            "label": "Update 25.0.3 [v983040]",
                            "desc": "Aggiornamento richiesto",
                            "href": "https://t.me/c/2332511567/1863",
                            "highlight": "cyan"
                        },
                        {
                            "icon": "bi-box-fill",
                            "iconColor": "#c084fc",
                            "label": "5 DLCs",
                            "desc": "Pacchetto DLC",
                            "href": "https://t.me/c/2332511567/1864",
                            "highlight": "purple"
                        },
                        {
                            "icon": "bi-folder-fill",
                            "iconColor": "#4ade80",
                            "label": "Offline Files",
                            "desc": "File offline da copiare nella cartella del gioco",
                            "href": "https://t.me/c/2332511567/1874",
                            "highlight": "green"
                        }
                    ]
                },
                {
                    "type": "list",
                    "items": [
                        { "icon": "bi-tools", "iconColor": "#facc15", "html": "<strong>DBI</strong> installato e funzionante sulla Switch." },
                        { "icon": "bi-usb-symbol", "iconColor": "#fb7185", "html": "Cavo <strong>USB-C</strong> per collegare la console al computer." }
                    ]
                }
            ]
        },
        {
            "id": "installazione",
            "title": "Sezione 1 - Installazione",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Installa base, update e DLC",
                    "blocks": [
                        { "type": "text", "content": "Installa <strong>base</strong>, <strong>update</strong> e <strong>DLC</strong> tramite DBI." }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Avvia Just Dance 2025 una prima volta",
                    "blocks": [
                        { "type": "text", "content": "Apri <strong>Just Dance 2025</strong> e chiudilo dopo la schermata di caricamento." }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Apri l'Homebrew Menu senza Applet Mode",
                    "blocks": [
                        { "type": "text", "content": "Apri un qualunque gioco tenendo premuto <strong>R</strong>. In questo modo entrerai nell'Homebrew Menu senza Applet Mode." }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Collega la console al computer",
                    "blocks": [
                        { "type": "text", "content": "Collega il cavo <strong>USB-C</strong> dal computer alla console, poi entra in <strong>DBI</strong>." },
                        { "type": "infobox", "variant": "info", "title": "Background nero?", "titleIcon": "bi-info-circle-fill", "content": "E normale: molto probabilmente il background di DBI sara nero." }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Avvia Run MTP responder",
                    "blocks": [
                        { "type": "text", "content": "Premi su <strong>Run MTP responder</strong> per aprire il file explorer della console sul computer." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/scren_dbi_nero_runmptresponder_evidenziato.webp",
                            "alt": "DBI Run MTP responder",
                            "caption": "Premi Run MTP responder"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Apri Saves",
                    "blocks": [
                        { "type": "text", "content": "Dal file explorer della console entra in <strong>Saves</strong>." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/scren_esplorafiletodbi_struttura.webp",
                            "alt": "Struttura file explorer DBI",
                            "caption": "Entra nella sezione Saves"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 7,
                    "title": "Apri Installed games",
                    "blocks": [
                        { "type": "text", "content": "Entra nella cartella <strong>Installed games</strong>." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_cartella_installedgames.webp",
                            "alt": "Cartella Installed games",
                            "caption": "Cartella Installed games"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 8,
                    "title": "Apri la cartella Just Dance",
                    "blocks": [
                        { "type": "text", "content": "Entra nella cartella <strong>Just Dance</strong>. Rimani dentro questa cartella: servira nella parte successiva." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_cartella_justdance.webp",
                            "alt": "Cartella Just Dance",
                            "caption": "Cartella Just Dance"
                        }
                    ]
                }
            ]
        },
        {
            "id": "offline-files",
            "title": "Sezione 2 - Estrazione Offline Files",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Estrai gli Offline Files",
                    "blocks": [
                        { "type": "text", "content": "Estrai la cartella compressa <strong>Just Dance 2025 [Offline Files].zip</strong>." }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Apri Cache Data",
                    "blocks": [
                        { "type": "text", "content": "Entra nella cartella appena estratta e apri <strong>Cache Data</strong>." }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Copia i contenuti nella cartella Just Dance",
                    "blocks": [
                        { "type": "text", "content": "Sposta tutto il contenuto presente in <strong>Cache Data</strong> nella cartella <strong>Just Dance</strong> aperta dal file explorer della console." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_esplorafile_suddivisoin2finestre_sinistralocale_destrasd_illustrazione_cartellespostate.webp",
                            "alt": "Spostamento Cache Data nella cartella Just Dance",
                            "caption": "A sinistra i file locali, a destra la cartella Just Dance della console"
                        },
                        {
                            "type": "infobox",
                            "variant": "error",
                            "title": "Attenzione",
                            "titleIcon": "bi-exclamation-octagon-fill",
                            "content": "Copia le cartelle <strong>una alla volta</strong>, non tutte insieme come mostrato nell'immagine."
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "title": "Sostituzione file",
                            "titleIcon": "bi-files",
                            "content": "Se viene chiesto di sostituire file o cartelle, conferma la sostituzione. L'operazione puo richiedere parecchio tempo: attendi senza scollegare la console."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Copia il file Offline Save",
                    "blocks": [
                        { "type": "text", "content": "A fine operazione resta un ultimo file da spostare. Dalla cartella estratta <strong>Offline Gamesave Data + Cache Data</strong>, entra in <strong>Offline Gamesave Data</strong> e copia il file indicato." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_offlinesaventx.webp",
                            "alt": "File Offline Save",
                            "caption": "File Offline Save da copiare"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Incolla nella cartella utente",
                    "blocks": [
                        { "type": "text", "content": "Incolla il file nella cartella utente della console." },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "Nome utente diverso",
                            "titleIcon": "bi-person-fill",
                            "content": "La cartella utente mostrata nello screenshot ha un nome di esempio. Sulla tua console il nome sara diverso."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_cartellautente_evidenziata.webp",
                            "alt": "Cartella utente evidenziata",
                            "caption": "Cartella utente in cui incollare il file"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Chiudi DBI e avvia Just Dance",
                    "blocks": [
                        { "type": "text", "content": "Chiudi DBI e avvia <strong>Just Dance 2025</strong>. Se la lingua e cinese, segui la sezione successiva." }
                    ]
                }
            ]
        },
        {
            "id": "lingua",
            "title": "Sezione 3 - Cambio Lingua",
            "icon": "bi-3-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Apri Just Dance 2025",
                    "blocks": [
                        { "type": "text", "content": "Avvia <strong>Just Dance 2025</strong> dalla Home della Switch." }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Apri le impostazioni",
                    "blocks": [
                        { "type": "text", "content": "Premi l'icona dell'ingranaggio in basso a sinistra." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_home_justdance_settings_evidenziato.webp",
                            "alt": "Impostazioni Just Dance 2025",
                            "caption": "Icona impostazioni in basso a sinistra"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Apri Audio e Lingua",
                    "blocks": [
                        { "type": "text", "content": "Entra nella sezione <strong>Audio e Lingua</strong>." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_audioelingua_evidenz.webp",
                            "alt": "Audio e Lingua",
                            "caption": "Sezione Audio e Lingua"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Seleziona Lingua",
                    "blocks": [
                        { "type": "text", "content": "Seleziona la voce <strong>Lingua</strong>." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_sezlingua_evidenz.webp",
                            "alt": "Sezione Lingua",
                            "caption": "Sezione Lingua"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Scegli la lingua",
                    "blocks": [
                        { "type": "text", "content": "Scegli la lingua che vuoi impostare." },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/justdance2025/screen_lingua_dacambiare.webp",
                            "alt": "Scelta lingua Just Dance 2025",
                            "caption": "Selezione lingua"
                        }
                    ]
                }
            ]
        },
        {
            "id": "conclusione",
            "title": "Conclusione",
            "icon": "bi-check-circle-fill",
            "blocks": [
                {
                    "type": "summary",
                    "title": "Completato",
                    "items": [
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "label": "Installazione", "text": "Base, update e DLC sono stati installati tramite DBI." },
                        { "icon": "bi-folder-check", "iconColor": "#60a5fa", "label": "Offline Files", "text": "I contenuti offline sono stati copiati nella cartella corretta." },
                        { "icon": "bi-translate", "iconColor": "#c084fc", "label": "Lingua", "text": "La lingua puo essere cambiata dalle impostazioni del gioco." }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Buon gameplay!",
                    "titleIcon": "bi-controller",
                    "content": "Ora puoi avviare Just Dance 2025 e giocare."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Serve supporto?",
                    "titleIcon": "bi-telegram",
                    "content": "Se hai bisogno di aiuto, entra nel gruppo Telegram di supporto.",
                    "cta": {
                        "label": "Nintendo ROMs Gruppo",
                        "href": "https://t.me/NintendoROMsGruppo",
                        "icon": "bi-telegram"
                    }
                }
            ]
        }
    ],
