{
    "id": "wii-str2hax",
    "title": "str2hax - Exploit Senza SD",
    "subtitle": "Modifica la Wii tramite connessione internet (DNS personalizzato)",
    "icon": "bi-wifi",
    "meta": {
        "tempo": "~25 minuti",
        "difficolta": "Avanzata",
        "tipo": "Senza SD Card"
    },
    "breadcrumb": [
        { "label": "Home",  "href": "/",                    "icon": "bi-house-fill" },
        { "label": "Guide", "href": "/guide" },
        { "label": "Wii",   "href": "/guide/wii" },
        { "label": "str2hax" }
    ],
    "toc": [
        { "id": "introduzione",  "label": "Introduzione" },
        { "id": "requisiti",     "label": "Requisiti" },
        { "id": "sezione1",      "label": "Sezione I — Connessione" },
        { "id": "sezione2",      "label": "Sezione II — Avvio Exploit" }
    ],
    "sections": [

        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "<strong>str2hax</strong> è un exploit per la Wii che viene attivato caricando il <strong>Contratto di Licenza con l'Utente Finale (EULA)</strong> della console. Richiede solo una <strong>connessione Internet</strong> che ti permetta di modificare il DNS sulla tua Wii."
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Avviso Importante sulla SD Card",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "content": "Anche se str2hax ti permette di installare l'Homebrew Channel su una Wii <strong>senza scheda SD</strong>, altri passaggi fondamentali successivi (come l'installazione di <strong>BootMii</strong>) richiedono comunque una SD card. Dovrai procurartene una prima di completare la modifica."
                },
                {
                    "type": "infobox",
                    "variant": "danger",
                    "title": "Verifica Compatibilità ISP",
                    "titleIcon": "bi-wifi-off",
                    "content": "Se il tuo <strong>provider internet (ISP)</strong> o l'ambiente di rete impedisce l'uso di <strong>server DNS personalizzati</strong>, str2hax <strong>non funzionerà</strong> e dovresti scegliere un altro exploit (come <a href=\"/guide/wii/wilbrand\" data-route>Wilbrand</a>)."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Nota su mod esistenti (CTGP Revolution / Project+)",
                    "titleIcon": "bi-disc-fill",
                    "content": "Se hai installato una mod come <strong>CTGP Revolution</strong> o <strong>Project+</strong>, str2hax potrebbe caricare quella invece dell'exploit. Se succede, <strong>riavvia la Wii</strong> e riprova <strong>senza la scheda SD inserita</strong>."
                }
            ]
        },

        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-list-check",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Cosa ti serve:",
                    "titleIcon": "bi-basket-fill",
                    "contentList": [
                        "✅ Una <strong>Nintendo Wii</strong>",
                        "✅ Una <strong>connessione Internet funzionante</strong> (Wi-Fi configurato sulla Wii)",
                        "✅ Possibilità di <strong>modificare le impostazioni DNS</strong> sulla Wii"
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "titleIcon": "bi-sd-card",
                    "content": "<strong>Ricorda:</strong> Una volta completato l'exploit, dovrai comunque procurarti una <strong>scheda SD</strong> per continuare con il backup NAND e l'installazione di homebrew aggiuntivi."
                }
            ]
        },

        {
            "id": "sezione1",
            "title": "Sezione I — Connessione",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Questo exploit richiede di <strong>configurare il DNS</strong> sulla Wii per connettersi a un server che contiene l'exploit."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Accendi la console",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Accendi la tua Nintendo Wii e attendi che carichi il Menu Home."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Vai su Opzioni Wii",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dal Menu Home della Wii, clicca sul pulsante <strong>Opzioni Wii</strong> (icona rotonda in basso a sinistra)."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_wii_home_options_evidenziato.webp",
                            "alt": "Wii Home - Opzioni evidenziate",
                            "caption": "Clicca su \"Opzioni Wii\" nel Menu Home"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Vai su Impostazioni console Wii",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca su <strong>Impostazioni console Wii</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_wii_settings.webp",
                            "alt": "Impostazioni console Wii",
                            "caption": "Seleziona \"Impostazioni console Wii\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Naviga a Pagina 2 → Internet → Impostazioni di connessione",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Usa le frecce per spostarti alla <strong>Pagina 2</strong>, quindi seleziona <strong>Internet</strong> → <strong>Impostazioni di connessione</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_wii_settings_page2_internet.webp",
                            "alt": "Wii Settings - Pagina 2 Internet",
                            "caption": "Pagina 2 — Seleziona \"Internet\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_wii_internet_connection_settings_select.webp",
                            "alt": "Internet - Impostazioni connessione",
                            "caption": "Seleziona \"Impostazioni di connessione\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Seleziona la tua connessione e vai su Modifica impostazioni",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca sullo <strong>slot della tua connessione di rete</strong> (Connection 1, 2 o 3 — quella che usi attualmente) e seleziona <strong>Modifica impostazioni</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_choose.webp",
                            "alt": "Scegli connessione",
                            "caption": "Seleziona la tua connessione attiva"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_changesettings.webp",
                            "alt": "Modifica impostazioni",
                            "caption": "Clicca su \"Modifica impostazioni\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Imposta Ottieni DNS automaticamente su NO",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Scorri verso il basso fino a <strong>Ottieni DNS automaticamente</strong> e impostalo su <strong>NO</strong>, quindi clicca su <strong>Impostazioni avanzate</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_obtaindns_advanced.webp",
                            "alt": "Ottieni DNS automaticamente - NO",
                            "caption": "Imposta su \"NO\" e vai su \"Impostazioni avanzate\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 7,
                    "title": "Imposta il DNS Primario",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Imposta il <strong>DNS Primario</strong> su <code>3.143.163.250</code>"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_dns_illustrazione.webp",
                            "alt": "Imposta DNS Primario",
                            "caption": "Inserisci 3.143.163.250 come DNS Primario"
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "<strong>Attenzione:</strong> Se vedi <strong>3 campi</strong> invece di 2 (come nell'immagine sopra), torna indietro e assicurati di essere sulla pagina \"Ottieni DNS automaticamente\"."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 8,
                    "title": "Conferma e salva",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca su <strong>Conferma</strong>, quindi su <strong>Salva</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_obtaindns_save.webp",
                            "alt": "Salva impostazioni DNS",
                            "caption": "Conferma e salva le modifiche"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 9,
                    "title": "Esegui il test di connessione",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Quando richiesto, clicca su <strong>OK</strong> per eseguire il test di connessione."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_saved_ok.webp",
                            "alt": "Impostazioni salvate",
                            "caption": "Clicca OK per il test di connessione"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_connection_successful_update_no.webp",
                            "alt": "Connessione riuscita - Salta aggiornamento",
                            "caption": "Test completato con successo"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Se il test di connessione ha avuto successo:",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Seleziona <strong>NO</strong> per saltare l'Aggiornamento di Sistema Wii (non vogliamo aggiornare il sistema in questo momento)."
                        },
                        {
                            "type": "infobox",
                            "variant": "danger",
                            "title": "Se fallisce con codice errore 521xx:",
                            "titleIcon": "bi-x-circle-fill",
                            "contentList": [
                                "Verifica di aver inserito il DNS correttamente: <code>3.143.163.250</code>",
                                "Se continua a non funzionare, prova un altro exploit come <a href=\"/guide/wii/wilbrand\" data-route>Wilbrand</a>"
                            ]
                        }
                    ]
                }
            ]
        },

        {
            "id": "sezione2",
            "title": "Sezione II — Avvio dell'Exploit",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora che il DNS è configurato, possiamo procedere ad attivare l'exploit tramite il menu EULA della Wii."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Vai su Internet → Contratti utente",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Torna al menu principale delle Impostazioni Wii, vai su <strong>Internet</strong> e seleziona <strong>Contratti utente</strong> o <strong>Contratto/Contatto</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Seleziona Sì",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Quando richiesto, seleziona <strong>Sì</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Clicca su Avanti",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca sul pulsante <strong>Avanti</strong>. Dovresti vedere apparire la seguente schermata di caricamento:"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_pleasewait_1_2_minutes.webp",
                            "alt": "Attendi 1-2 minuti",
                            "caption": "Schermata di caricamento dell'exploit"
                        },
                        {
                            "type": "infobox",
                            "variant": "danger",
                            "title": "Se vedi il normale Contratto Utente:",
                            "titleIcon": "bi-x-octagon-fill",
                            "content": "Il tuo ISP blocca l'uso di DNS personalizzati. Prova un'altra connessione o usa un altro exploit come <a href=\"/guide/wii/wilbrand\" data-route>Wilbrand</a>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Attendi 1-2 minuti",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dai all'exploit <strong>1-2 minuti</strong> per scaricare i file necessari."
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "<strong>NON premere</strong> \"ACCETTO\" o \"NON ACCETTO\" durante il caricamento — lascia semplicemente che l'exploit faccia il suo lavoro."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Exploit riuscito!",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Se l'exploit ha avuto successo, la tua console avrà caricato l'<strong>installer HackMii</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/str2hax/screen_exploit_hbc_pressone.webp",
                            "alt": "HackMii Installer caricato",
                            "caption": "Installer HackMii caricato con successo — Premi (1) per continuare"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Perfetto!",
                            "titleIcon": "bi-trophy-fill",
                            "content": "L'exploit è andato a buon fine. Procedi alla sezione successiva."
                        },
                        {
                            "type": "brick-list",
                            "title": "Risoluzione problemi:",
                            "items": [
                                {
                                    "title": "L'installer HackMii non si carica dopo più di 2 minuti",
                                    "desc": "Riavvia la Wii e riprova dall'inizio."
                                },
                                {
                                    "title": "Errore \"Hanging.\" o \"ERROR! if_config (ret = ...)\"",
                                    "desc": "Riavvia la Wii e riprova dall'inizio. Se continua a non funzionare, potrebbe esserci un problema con la tua rete — prova con un altro exploit."
                                }
                            ]
                        }
                    ]
                }
            ]
        }

        
    ],

