    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "error",
                    "title": "⚠️ Console Modificata Richiesta!",
                    "titleIcon": "bi-exclamation-octagon-fill",
                    "content": "Questa guida richiede una <strong>Nintendo Switch modificata</strong> con Atmosphere CFW installato. Se non l'hai ancora fatto, segui prima la guida completa di modifica.",
                    "cta": {
                        "label": "Vai alla Guida Modifica",
                        "href": "/guide/switch/requisiti",
                        "icon": "bi-tools"
                    }
                },
                {
                    "type": "text",
                    "content": "In questa guida vedremo come <strong>installare giochi</strong> sulla Switch modificata utilizzando <strong>Sphaira</strong> e un semplice cavo USB-C. È il metodo più veloce e pratico!"
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Perché Sphaira?",
                    "titleIcon": "bi-stars",
                    "content": "Sphaira è il nuovo homebrew launcher. È più moderno, veloce e include funzionalità MTP integrate per il trasferimento file!"
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-clipboard-check-fill",
            "blocks": [
                {
                    "type": "two-columns",
                    "columns": [
                        {
                            "title": "Hardware Necessario",
                            "icon": "bi-nintendo-switch",
                            "color": "#4ade80",
                            "borderColor": "rgba(74,222,128,0.3)",
                            "items": [
                                "Nintendo Switch modificata con Atmosphere CFW",
                                "MicroSD Card (consigliata 128GB o superiore)",
                                "Cavo USB-C (va bene anche quello del telefono)",
                                "PC con Windows (per trasferire i giochi)"
                            ]
                        },
                        {
                            "title": "Software Necessario",
                            "icon": "bi-pc-display-horizontal",
                            "color": "#60a5fa",
                            "borderColor": "rgba(96,165,250,0.3)",
                            "items": [
                                "Sphaira (homebrew launcher con MTP integrato)",
                                "Giochi in formato NSP/XCI",
                                "Update e DLC (opzionali)"
                            ]
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "📦 Formati supportati:",
                    "titleIcon": "bi-box",
                    "contentList": [
                        ".NSP",
                        ".XCI",
                        ".NSZ",
                        ".XCZ"
                    ]
                }
            ]
        },
        {
            "id": "parte-1",
            "title": "Parte 1 - Installazione Sphaira",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Hai già Sphaira?",
                    "titleIcon": "bi-lightbulb-fill",
                    "content": "Se Sphaira è già presente nella tua SD, <strong>salta alla Parte 2</strong>!"
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Scarica Sphaira",
                    "blocks": [
                        {
                            "type": "download-list",
                            "title": "Download Sphaira",
                            "titleIcon": "bi-file-earmark-zip-fill",
                            "items": [
                                {
                                    "icon": "bi-download",
                                    "iconColor": "#c084fc",
                                    "label": "Sphaira.zip",
                                    "desc": "Homebrew Launcher moderno con MTP integrato",
                                    "href": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/sphaira.zip",
                                    "highlight": "purple"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Vai nella Home di Hekate",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Avvia la Switch in RCM e carica Hekate. Ti ritroverai nella schermata Home."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/hekate_6.5.1_home.webp",
                            "alt": "Home di Hekate",
                            "caption": "Schermata Home di Hekate"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Apri la sezione Tools",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca su <strong>Tools</strong> nella barra in alto."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/hekate_tools.webp",
                            "alt": "Sezione Tools di Hekate",
                            "caption": "Sezione Tools di Hekate"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Collega USB e apri SD Card",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Collega il cavo USB-C tra Switch e PC. Nella sezione <strong>USB Mass Storage</strong>, premi su <strong>SD Card</strong> per montare la microSD sul PC."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/hekate_sdcard_option.webp",
                            "alt": "Opzione SD Card in Hekate Tools",
                            "caption": "Premi su \"SD Card\" nella sezione USB Mass Storage"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Trasferisci Sphaira nella SD",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Sul PC, la SD Card verrà rilevata automaticamente. Estrai il contenuto di <code>sphaira.zip</code> scaricato precedentemente. Troverai una cartella chiamata <strong>\"switch\"</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/hekate_usbtools_sphaira_da_spostare.webp",
                            "alt": "SD Card visibile su PC con Sphaira da trasferire",
                            "caption": "La SD Card è ora accessibile dal PC - Trascina la cartella \"switch\" qui"
                        },
                        {
                            "type": "spec-box",
                            "title": "Come trasferire",
                            "titleIcon": "bi-folder-fill",
                            "color": "#4ade80",
                            "borderColor": "rgba(74,222,128,0.3)",
                            "items": [
                                { "icon": "bi-1-circle-fill", "iconColor": "#4ade80", "label": "Estrai", "desc": "Estrai il file sphaira.zip appena scaricato" },
                                { "icon": "bi-2-circle-fill", "iconColor": "#4ade80", "label": "Trascina", "desc": "Trascina la cartella \"switch\" nella radice della SD" },
                                { "icon": "bi-3-circle-fill", "iconColor": "#4ade80", "label": "Unisci", "desc": "Se ti chiede di unire le cartelle, conferma con Sì" }
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "title": "Non cancellare la cartella esistente!",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "Se esiste già una cartella \"switch\" nella SD, <strong>non eliminarla</strong>. Trasferendo la nuova cartella, i file verranno semplicemente aggiunti/aggiornati."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Chiudi il trasferimento USB",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Sulla Switch, premi contemporaneamente i tasti <kbd>Volume +</kbd> e <kbd>Volume -</kbd>. Poi clicca su <strong>Close</strong> al centro, e <strong>Close</strong> in alto a destra."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 7,
                    "title": "Avvia la emuNAND",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Torna nella sezione <strong>Home</strong> → <strong>Launch</strong> → Seleziona <strong>Micro SD (CFW)</strong> per avviare la emuNAND."
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-2",
            "title": "Parte 2 - Download Giochi",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora che Sphaira è installato, scarica i giochi dal nostro canale Telegram!"
                },
                {
                    "type": "cta-box",
                    "title": "Nintendo ROMs",
                    "icon": "bi-telegram",
                    "content": "Oltre 2000+ giochi per tutte le console Nintendo, aggiornati costantemente con update e DLC!",
                    "button": {
                        "label": "Unisciti",
                        "href": "https://t.me/+VhTgmHwgmNk1NjY0",
                        "icon": "bi-telegram"
                    }
                },
                {
                    "type": "image",
                    "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/screenshot_canale_telegram_nintendoroms.webp",
                    "alt": "Canale Telegram Nintendo Roms",
                    "caption": "Libreria completa di giochi Nintendo sempre aggiornata"
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "File multi-parte?",
                    "titleIcon": "bi-puzzle-fill",
                    "content": "Alcuni giochi grandi sono divisi in più parti (es: .zip.001, .zip.002). Devi <strong>estrarre/unire le parti prima</strong> di installarle! Usa 7-Zip o WinRAR per estrarre."
                }
            ]
        },
        {
            "id": "parte-3",
            "title": "Parte 3 - Configurazione e Installazione",
            "icon": "bi-3-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora configuriamo Sphaira e installiamo i giochi!"
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Apri un gioco tenendo R premuto",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dal menu HOME della Switch, apri <strong>un qualsiasi gioco/app</strong> tenendo premuto il tasto <kbd>R</kbd> all'avvio."
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "Perché tenere R?",
                            "titleIcon": "bi-info-circle-fill",
                            "content": "Tenendo R si esce dalla \"Applet Mode\" e si avvia l'Homebrew Menu con accesso completo alla memoria, necessario per l'installazione giochi."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Avvia Sphaira",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nel menu Homebrew, seleziona <strong>Sphaira</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/hbmenu_home.webp",
                            "alt": "Homebrew Menu con Sphaira",
                            "caption": "Seleziona Sphaira nel Homebrew Menu"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Home di Sphaira",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Ti ritroverai nella schermata principale di Sphaira."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/sphaira_home.webp",
                            "alt": "Home di Sphaira",
                            "caption": "Schermata principale di Sphaira"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Apri le Opzioni",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Premi <kbd>X</kbd> per aprire il menu delle opzioni."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/sphaira_options.webp",
                            "alt": "Opzioni di Sphaira",
                            "caption": "Menu opzioni di Sphaira"
                        },
                        {
                            "type": "text",
                            "content": "Clicca su <strong>Rete</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Vai nella sezione MTP",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Seleziona <strong>MTP</strong> dal menu."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/sphaira_mtp.webp",
                            "alt": "Sezione MTP di Sphaira",
                            "caption": "Sezione MTP nelle impostazioni"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Abilita MTP",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Assicurati che l'opzione <strong>Enable</strong> sia impostata su <strong>ON</strong>. Se non lo è, abilitala!"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/sphaira_mtp_enable.webp",
                            "alt": "MTP Enable su ON",
                            "caption": "MTP abilitato - Enable su ON"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 7,
                    "title": "Attiva MTP Install",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Ora premi <kbd>Y</kbd> poi vai su <strong>Menus</strong> e seleziona <strong>MTP Install</strong>."
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "Perché MTP Install?",
                            "titleIcon": "bi-info-circle-fill",
                            "content": "Questa modalità permette di installare i giochi direttamente trasferendoli via USB, senza doverli prima copiare sulla SD!"
                        },
                        {
                            "type": "settings-box",
                            "title": "Percorso:",
                            "items": [
                                { "label": "Sequenza:", "value": "Y → Menus → MTP Install" }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 8,
                    "title": "Collega il cavo USB-C",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Ora collega la Switch al PC tramite il cavo USB-C. Il PC rileverà automaticamente la Switch come dispositivo."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/installazione-giochi/disco-switch.webp",
                            "alt": "Switch rilevata su PC",
                            "caption": "La Switch appare come dispositivo su PC con diverse cartelle"
                        },
                        {
                            "type": "file-tree",
                            "title": "Cartelle disponibili:",
                            "items": [
                                { "name": "Album (Image SD)", "type": "folder", "depth": 0, "comment": "Screenshot e video" },
                                { "name": "Games", "type": "folder", "depth": 0, "comment": "Giochi installati" },
                                { "name": "Install (NSP, XCI, NSZ, XCZ)", "type": "folder", "depth": 0, "highlight": true, "comment": "Quella che ci serve!" }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 9,
                    "title": "Apri la cartella Install",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Apri la cartella <strong>\"Install (NSP, XCI, NSZ, XCZ)\"</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 10,
                    "title": "Trascina i giochi!",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Trascina i file dei giochi (NSP/XCI/NSZ/XCZ) scaricati dal canale Telegram dentro questa cartella. I giochi verranno installati automaticamente!"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 11,
                    "title": "Attendi l'installazione",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Sphaira installerà automaticamente il gioco."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 12,
                    "title": "Esci e Gioca!",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Quando hai finito, scollega il cavo USB e premi <kbd>HOME</kbd> per tornare al menu principale."
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Giochi installati!",
                            "titleIcon": "bi-trophy-fill",
                            "content": "I giochi appariranno automaticamente nel menu HOME della Switch! Buon divertimento!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "problemi",
            "title": "Problemi Comuni",
            "icon": "bi-tools",
            "blocks": [
                {
                    "type": "brick-list",
                    "title": "Risoluzione Problemi",
                    "items": [
                        {
                            "title": "Il PC non rileva la Switch",
                            "desc": "Hai abilitato MTP nelle opzioni di Sphaira? Hai attivato MTP Install dal menu Menus? Il cavo USB-C è funzionante? Hai provato un'altra porta USB del PC?"
                        },
                        {
                            "title": "Errore durante l'installazione",
                            "desc": "Possibili cause: File NSP/XCI corrotto (ri-scaricalo), SD piena (libera spazio), o file multi-parte non estratto correttamente."
                        },
                        {
                            "title": "Il gioco non appare nel menu HOME",
                            "desc": "Riavvia la console completamente. Verifica che l'installazione sia completata al 100%. Controlla che il file non sia solo un update/DLC (serve il gioco base!)."
                        },
                        {
                            "title": "Non trovo Sphaira nel Homebrew Menu",
                            "desc": "Hai estratto correttamente lo zip di Sphaira? La cartella \"switch\" è nella radice della SD? Dentro la cartella switch c'è il file .nro di Sphaira?"
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Serve aiuto?",
                    "titleIcon": "bi-telegram",
                    "content": "Contattaci sul gruppo Telegram!",
                    "cta": {
                        "label": "Gruppo di Supporto",
                        "href": "https://t.me/NintendoROMsGruppo",
                        "icon": "bi-telegram"
                    }
                }
            ]
        },
        {
            "id": "riepilogo",
            "title": "Riepilogo",
            "icon": "bi-check-circle-fill",
            "blocks": [
                {
                    "type": "summary",
                    "title": "Passaggi Principali",
                    "items": [
                        { "icon": "bi-1-circle-fill", "iconColor": "#4ade80", "label": "Sphaira", "text": "Scarica e installa Sphaira sulla SD (tramite Hekate USB)" },
                        { "icon": "bi-2-circle-fill", "iconColor": "#4ade80", "label": "Giochi", "text": "Scarica giochi dal canale Telegram" },
                        { "icon": "bi-3-circle-fill", "iconColor": "#4ade80", "label": "Avvio", "text": "Avvia emuNAND → Apri un gioco tenendo R → Sphaira" },
                        { "icon": "bi-4-circle-fill", "iconColor": "#4ade80", "label": "MTP", "text": "Abilita MTP nelle opzioni (X → Rete → MTP → Enable ON) e attiva MTP Install (Y → Menus → MTP Install)" },
                        { "icon": "bi-5-circle-fill", "iconColor": "#4ade80", "label": "Installazione", "text": "Collega USB-C → Apri \"Install (NSP, XCI...)\" → Trascina i giochi e attendi l'installazione" }
                    ]
                }
            ]
        }
    ],
