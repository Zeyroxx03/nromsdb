    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "<strong>Priiloader</strong> è uno strumento essenziale creato da <strong>DacoTaco</strong> che aggiunge un <strong>livello di protezione da brick</strong> alla tua Wii. Si carica <strong>prima del Menu di Sistema Wii</strong>, permettendo di intervenire anche se il sistema è danneggiato."
                },
                {
                    "type": "spec-box",
                    "title": "Cosa può fare Priiloader?",
                    "titleIcon": "bi-star-fill",
                    "color": "#c084fc",
                    "borderColor": "rgba(192,132,252,0.3)",
                    "items": [
                        {
                            "icon": "bi-shield-fill-check",
                            "iconColor": "#4ade80",
                            "label": "Protezione da Brick",
                            "desc": "Caricandosi prima del Menu Wii, può salvare la console anche se il sistema è corrotto"
                        },
                        {
                            "icon": "bi-wrench",
                            "iconColor": "#60a5fa",
                            "label": "Hacks del Sistema",
                            "desc": "Applica modifiche per migliorare, sbloccare e correggere funzionalità del Menu Wii"
                        },
                        {
                            "icon": "bi-lightning-fill",
                            "iconColor": "#facc15",
                            "label": "Avvio Rapido",
                            "desc": "Lancia velocemente qualsiasi titolo o homebrew, o cambia il comportamento di autoboot"
                        },
                        {
                            "icon": "bi-unlock-fill",
                            "iconColor": "#22d3ee",
                            "label": "Sblocco Funzioni",
                            "desc": "Rimuove limitazioni regionali, blocco aggiornamenti e altre restrizioni"
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "success",
                    "title": "Altamente Raccomandato!",
                    "titleIcon": "bi-shield-fill-check",
                    "content": "Priiloader è <strong>specialmente importante</strong> per chi ha BootMii installato come IOS (la maggior parte degli utenti). Offre un secondo strato di protezione essenziale."
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-list-check",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Cosa ti serve:",
                    "titleIcon": "bi-basket-fill",
                    "contentList": [
                        "✅ Una <strong>scheda SD</strong> o <strong>chiavetta USB</strong>",
                        "✅ <strong>Priiloader Installer</strong> (da scaricare)",
                        "✅ <strong>Load Priiloader</strong> (da scaricare)"
                    ]
                },
                {
                    "type": "download-list",
                    "title": "File da Scaricare",
                    "titleIcon": "bi-download",
                    "items": [
                        {
                            "icon": "bi-shield-fill-plus",
                            "iconColor": "#c084fc",
                            "label": "Priiloader Installer",
                            "desc": "Installer principale di Priiloader",
                            "href": "https://oscwii.org/library/app/priiloader"
                        },
                        {
                            "icon": "bi-box-arrow-in-right",
                            "iconColor": "#60a5fa",
                            "label": "Load Priiloader",
                            "desc": "App per accedere a Priiloader dall'Homebrew Channel",
                            "href": "https://oscwii.org/library/app/loadpriiloader"
                        }
                    ]
                }
            ]
        },
        {
            "id": "sezione1",
            "title": "Sezione I — Preparazione",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Spegni la console",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Spegni completamente la tua Wii."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Inserisci SD/USB nel computer",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Inserisci la tua scheda SD o chiavetta USB nel computer."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Copia LoadPriiloader sulla SD/USB",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Estrai <strong>LoadPriiloader.zip</strong> e copia la cartella <code>apps</code> nella <strong>radice</strong> della tua scheda SD o chiavetta USB."
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "titleIcon": "bi-info-circle-fill",
                            "content": "Se la cartella <code>apps</code> esiste già, unisci i contenuti (non sostituire l'intera cartella)."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Copia Priiloader Installer sulla SD/USB",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Estrai <strong>priiloader.zip</strong> e copia la cartella <code>apps</code> nella <strong>radice</strong> della tua scheda SD o chiavetta USB."
                        },
                        {
                            "type": "file-tree",
                            "title": "Struttura SD / USB",
                            "items": [
                                {
                                    "name": "SD Card / USB Drive",
                                    "type": "drive",
                                    "depth": 0
                                },
                                {
                                    "name": "apps",
                                    "type": "folder",
                                    "depth": 1
                                },
                                {
                                    "name": "priiloader",
                                    "type": "folder",
                                    "depth": 2
                                },
                                {
                                    "name": "LoadPriiloader",
                                    "type": "folder",
                                    "depth": 2
                                },
                                {
                                    "name": "...",
                                    "depth": 2,
                                    "dim": true,
                                    "last": true,
                                    "comment": "altre app homebrew"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Reinserisci SD/USB nella console",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Rimuovi in sicurezza la SD/USB dal computer e inseriscila nella Wii."
                        }
                    ]
                }
            ]
        },
        {
            "id": "sezione2",
            "title": "Sezione II — Installazione Priiloader",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Accendi la console",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Accendi la tua Nintendo Wii."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Avvia l'Homebrew Channel",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dal Menu Wii, avvia l'<strong>Homebrew Channel</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Lancia Priiloader Installer",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dalla lista degli homebrew, seleziona e avvia <strong>Priiloader Installer</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/priiloader/screen_hbchannel_priiloader_installer.webp",
                            "alt": "Homebrew Channel - Priiloader Installer",
                            "caption": "Seleziona \"Priiloader Installer\" dall'Homebrew Channel"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Avvia l'installazione",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Premi il pulsante <strong>+ (Plus)</strong> sul Wiimote o il pulsante <strong>A</strong> su un controller GameCube."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/priiloader/screen_priiloader_plus.webp",
                            "alt": "Priiloader - Premi Plus per installare",
                            "caption": "Premi + (Plus) sul Wiimote per iniziare l'installazione"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Installazione in corso",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "L'installazione di Priiloader inizierà. Attendi il completamento."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/priiloader/screen_priiloader_download.webp",
                            "alt": "Priiloader - Installazione in corso",
                            "caption": "Installazione di Priiloader in corso — non spegnere la console"
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "<strong>Importante:</strong> NON spegnere o riavviare la console durante l'installazione!"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Installazione completata",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Una volta completata l'installazione, premi <strong>A</strong> per tornare all'Homebrew Channel."
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Priiloader è stato installato con successo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "sezione3",
            "title": "Sezione III — Accedere a Priiloader",
            "icon": "bi-3-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Esci dal Menu di Sistema",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Premi il pulsante <strong>HOME</strong>, quindi seleziona <strong>Exit to System Menu</strong> per uscire dall'Homebrew Channel. Il tuo dispositivo avrà caricato il <strong>menu Priiloader</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/priiloader/screen_priiloader_home.webp",
                            "alt": "Priiloader - Menu principale",
                            "caption": "Menu principale di Priiloader"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-trophy-fill",
                            "content": "Perfetto! Ora sei dentro Priiloader per la prima volta."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Come accedere a Priiloader in futuro",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "In seguito, per accedere a Priiloader puoi utilizzare uno di questi metodi:"
                        },
                        {
                            "type": "two-columns",
                            "columns": [
                                {
                                    "title": "Metodo 1: Pulsante RESET",
                                    "icon": "bi-power",
                                    "color": "#60a5fa",
                                    "borderColor": "rgba(96,165,250,0.3)",
                                    "items": [
                                        "Tieni premuto il pulsante RESET sulla Wii mentre la accendi",
                                        "Rilascia quando appare il menu Priiloader"
                                    ]
                                },
                                {
                                    "title": "Metodo 2: Load Priiloader",
                                    "icon": "bi-app",
                                    "color": "#4ade80",
                                    "borderColor": "rgba(74,222,128,0.3)",
                                    "items": [
                                        "Avvia l'applicazione \"Load Priiloader\" dall'Homebrew Channel",
                                        "Oppure tieni premuto ESC su tastiera USB all'avvio"
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "sezione4",
            "title": "Sezione IV — Configurazione Priiloader",
            "icon": "bi-4-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora configureremo gli <strong>System Menu Hacks</strong> di Priiloader per migliorare la sicurezza e le prestazioni della tua Wii."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Accedi a System Menu Hacks",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Scorri verso il basso fino a <strong>System Menu Hacks</strong> e premi <strong>A</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/priiloader/screen_priiloader_home_system_menu_hacks.webp",
                            "alt": "Priiloader - System Menu Hacks",
                            "caption": "Seleziona \"System Menu Hacks\""
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "Se hai messo l'installer di Priiloader su USB, assicurati di <strong>NON avere una SD card inserita</strong> contemporaneamente, altrimenti Priiloader non riuscirà a trovare il file <code>hacks_hash.ini</code>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Abilita gli hack consigliati",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Per la tua <strong>Wii standard</strong>, abilita le seguenti opzioni (premi <strong>A</strong> su ciascuna per attivarla):"
                        },
                        {
                            "type": "spec-box",
                            "title": "Hack Consigliati per Wii",
                            "titleIcon": "bi-check-square-fill",
                            "color": "#60a5fa",
                            "borderColor": "rgba(96,165,250,0.3)",
                            "items": [
                                {
                                    "icon": "bi-check-circle-fill",
                                    "iconColor": "#4ade80",
                                    "label": "Block Disc Updates",
                                    "desc": "Impedisce aggiornamenti automatici da dischi di gioco"
                                },
                                {
                                    "icon": "bi-check-circle-fill",
                                    "iconColor": "#4ade80",
                                    "label": "Block Online Updates",
                                    "desc": "Blocca aggiornamenti di sistema via internet"
                                },
                                {
                                    "icon": "bi-question-circle-fill",
                                    "iconColor": "#facc15",
                                    "label": "480p graphics fix in system menu",
                                    "desc": "<strong>SOLO se usi modalità 480p:</strong> Corregge problemi grafici in 480p"
                                },
                                {
                                    "icon": "bi-question-circle-fill",
                                    "iconColor": "#22d3ee",
                                    "label": "Remove Deflicker",
                                    "desc": "<strong>SOLO se NON usi un TV CRT:</strong> Rimuove il filtro deflicker per immagini più nitide"
                                }
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "Come navigare:",
                            "titleIcon": "bi-lightbulb-fill",
                            "contentList": [
                                "Usa il <strong>D-Pad</strong> per scorrere le opzioni",
                                "Premi <strong>A</strong> per attivare/disattivare un hack (vedrai una <strong>✓</strong>)",
                                "Gli hack attivi sono evidenziati"
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Salva le impostazioni",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Scorri verso il basso fino a <strong>save settings</strong> e premi <strong>A</strong>."
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Le impostazioni sono state salvate!"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Torna al menu principale",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Premi <strong>B</strong> per tornare al menu principale di Priiloader."
                        }
                    ]
                }
            ]
        },
