    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "error",
                    "title": "Avviso Importante",
                    "titleIcon": "bi-exclamation-octagon-fill",
                    "content": "<strong>NON tentare</strong> di installare IOS o Menu di Sistema per Wii Mini sulla tua Wii standard. Farlo probabilmente <strong>brickerà</strong> la tua console."
                },
                {
                    "type": "text",
                    "content": "I <strong>cIOS</strong> (Custom IOS) sono versioni modificate degli IOS di sistema della Wii che sbloccano funzionalità aggiuntive non disponibili negli IOS ufficiali."
                },
                {
                    "type": "spec-box",
                    "title": "A cosa servono i cIOS?",
                    "titleIcon": "bi-star-fill",
                    "color": "#4ade80",
                    "borderColor": "rgba(74,222,128,0.3)",
                    "items": [
                        {
                            "icon": "bi-usb-symbol",
                            "iconColor": "#60a5fa",
                            "label": "USB Loader",
                            "desc": "Permette di caricare backup di giochi Wii e GameCube da chiavette USB o hard disk"
                        },
                        {
                            "icon": "bi-hdd-fill",
                            "iconColor": "#c084fc",
                            "label": "Supporto Hardware USB",
                            "desc": "Abilita l'accesso completo a dispositivi di archiviazione USB"
                        },
                        {
                            "icon": "bi-controller",
                            "iconColor": "#22d3ee",
                            "label": "Emulatori Avanzati",
                            "desc": "Necessari per alcuni emulatori e homebrew avanzati"
                        },
                        {
                            "icon": "bi-shield-check",
                            "iconColor": "#4ade80",
                            "label": "Funzionalità Extra",
                            "desc": "Sblocca capacità non disponibili negli IOS stock"
                        }
                    ]
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-list-check",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Cosa ti serve:",
                    "titleIcon": "bi-basket-fill",
                    "contentList": [
                        "✅ Una <strong>Wii</strong> con l'Homebrew Channel installato",
                        "✅ Una <strong>scheda SD</strong> o <strong>chiavetta USB</strong>",
                        "✅ <strong>d2x cIOS Installer</strong> (da scaricare)",
                        "✅ <strong>NUS Downloader</strong> (da scaricare — solo per PC Windows)"
                    ]
                },
                {
                    "type": "download-list",
                    "title": "File da Scaricare",
                    "titleIcon": "bi-download",
                    "items": [
                        {
                            "icon": "bi-disc-fill",
                            "iconColor": "#4ade80",
                            "label": "d2x cIOS Installer",
                            "desc": "Installer per i Custom IOS sulla Wii",
                            "href": "https://oscwii.org/library/app/d2x-cios-installer"
                        },
                        {
                            "icon": "bi-cloud-arrow-down-fill",
                            "iconColor": "#60a5fa",
                            "label": "NUS Downloader (NUSD)",
                            "desc": "Tool per scaricare i file IOS dai server Nintendo — Solo Windows",
                            "href": "https://github.com/WiiDatabase/nusdownloader/releases"
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "titleIcon": "bi-sd-card-fill",
                    "content": "Assicurati che la SD card sia <strong>sbloccata</strong>! Se l'interruttore di blocco è attivo, non potrai selezionare le opzioni corrette nell'installer."
                }
            ]
        },
        {
            "id": "sezione1",
            "title": "Sezione I — Download IOS",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "In questa sezione scaricheremo i file <strong>IOS necessari</strong> utilizzando <strong>NUS Downloader</strong>, un tool che scarica file direttamente dai server Nintendo."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Prepara NUS Downloader",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Scarica NUS Downloader, estrai tutti i file in una cartella sul tuo computer (es: <code>C:\\NUS-Downloader</code>) e avvia <strong>NUS Downloader.exe</strong>."
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-shield-exclamation",
                            "content": "Windows Defender potrebbe bloccare il programma. È un <strong>falso positivo</strong> — consenti l'esecuzione. NUS Downloader è uno strumento sicuro ampiamente utilizzato nella community."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Scarica IOS38 v4123",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nel menu di NUS Downloader, vai su <strong>Database → IOS → IOS38</strong>, quindi seleziona <strong>v4123</strong>."
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "title": "Impostazioni importanti:",
                            "titleIcon": "bi-gear-fill",
                            "contentList": [
                                "✅ <strong>Assicurati che \"Pack WAD\" sia spuntato</strong>",
                                "❌ <strong>NON spuntare \"Patch IOS\"</strong> — è compito del cIOS Installer"
                            ]
                        },
                        {
                            "type": "text",
                            "content": "Clicca su <strong>Start NUS Download!</strong> e attendi il completamento."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Scarica gli altri 3 IOS",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Ripeti i passaggi del punto precedente per scaricare anche:"
                        },
                        {
                            "type": "list",
                            "items": [
                                {
                                    "icon": "bi-arrow-right-short",
                                    "iconColor": "#60a5fa",
                                    "html": "<strong>IOS56 v5661</strong>"
                                },
                                {
                                    "icon": "bi-arrow-right-short",
                                    "iconColor": "#c084fc",
                                    "html": "<strong>IOS57 v5918</strong>"
                                },
                                {
                                    "icon": "bi-arrow-right-short",
                                    "iconColor": "#22d3ee",
                                    "html": "<strong>IOS58 v6175</strong>"
                                }
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Ricordati: per ognuno, <strong>spunta \"Pack WAD\"</strong> e <strong>NON spuntare \"Patch IOS\"</strong>!"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Trova e copia i file WAD",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nella cartella di NUS Downloader troverai una cartella <strong>titles</strong>. Naviga attraverso le sottocartelle per localizzare i <strong>quattro file WAD</strong> scaricati e copiali nella <strong>radice</strong> della tua SD card o chiavetta USB."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_structure_wad.webp",
                            "alt": "Struttura file WAD sulla SD",
                            "caption": "I 4 file WAD nella radice della SD card"
                        },
                        {
                            "type": "file-tree",
                            "title": "Struttura SD / USB",
                            "items": [
                                {
                                    "name": "SD Card / USB Drive",
                                    "type": "drive",
                                    "depth": 0
                                },
                                {
                                    "name": "IOS38-64-v4123.wad",
                                    "depth": 1,
                                    "highlight": true
                                },
                                {
                                    "name": "IOS56-64-v5661.wad",
                                    "depth": 1,
                                    "highlight": true
                                },
                                {
                                    "name": "IOS57-64-v5918.wad",
                                    "depth": 1,
                                    "highlight": true
                                },
                                {
                                    "name": "IOS58-64-v6175.wad",
                                    "depth": 1,
                                    "highlight": true
                                },
                                {
                                    "name": "apps",
                                    "type": "folder",
                                    "depth": 1
                                },
                                {
                                    "name": "d2x-cios-installer",
                                    "type": "folder",
                                    "depth": 2
                                },
                                {
                                    "name": "...",
                                    "depth": 2,
                                    "dim": true,
                                    "last": true,
                                    "comment": "altre app homebrew"
                                }
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "I WAD devono essere sullo <strong>stesso dispositivo</strong> (SD o USB) che contiene il d2x cIOS Installer!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "sezione2",
            "title": "Sezione II — Installazione cIOS",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora installeremo i <strong>4 cIOS</strong> (248, 249, 250, 251) utilizzando il d2x cIOS Installer."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Avvia d2x cIOS Installer",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Inserisci la SD/USB nella Wii, accendi la console, avvia l'<strong>Homebrew Channel</strong> e lancia <strong>d2x cIOS Installer</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Installa cIOS 248",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Imposta la configurazione come segue:"
                        },
                        {
                            "type": "settings-box",
                            "title": "Configurazione cIOS 248:",
                            "titleIcon": "bi-gear-fill",
                            "items": [
                                {
                                    "label": "Select cIOS:",
                                    "value": "d2x-v11-beta3"
                                },
                                {
                                    "label": "Select cIOS base:",
                                    "value": "38"
                                },
                                {
                                    "label": "Select cIOS slot:",
                                    "value": "248"
                                },
                                {
                                    "label": "Select cIOS revision:",
                                    "value": "65535"
                                }
                            ]
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_structure.webp",
                            "alt": "d2x cIOS Installer - Configurazione 248",
                            "caption": "Configurazione per cIOS 248"
                        },
                        {
                            "type": "text",
                            "content": "Premi <strong>A</strong> due volte per avviare l'installazione. Verifica che lo slot diventi <strong>verde</strong> al termine."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_248.webp",
                            "alt": "d2x - Mappa slot 248",
                            "caption": "Mappa slot prima dell'installazione"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_248iosgreen.webp",
                            "alt": "d2x - Slot 248 verde",
                            "caption": "Slot 248 evidenziato in verde = installazione riuscita"
                        },
                        {
                            "type": "brick-list",
                            "title": "Risoluzione problemi:",
                            "items": [
                                {
                                    "title": "NON vedi \"d2x-v11-beta3\"",
                                    "desc": "Esci dall'installer con B e assicurati che la SD sia sbloccata."
                                },
                                {
                                    "title": "Lo slot è evidenziato in rosso",
                                    "desc": "Prova a reinstallare il cIOS ripetendo i passaggi precedenti."
                                },
                                {
                                    "title": "Errori tcp_connect timeout o net_gethostbyname",
                                    "desc": "Premi B per uscire e riprendi dalla Sezione I (riscaricare i file WAD)."
                                },
                                {
                                    "title": "\"Slot ### already used...\"",
                                    "desc": "Premi - (meno) per disabilitare la modalità batch."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Installa cIOS 249",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Torna alla schermata di configurazione e imposta:"
                        },
                        {
                            "type": "settings-box",
                            "title": "Configurazione cIOS 249:",
                            "titleIcon": "bi-gear-fill",
                            "items": [
                                {
                                    "label": "Select cIOS:",
                                    "value": "d2x-v11-beta3"
                                },
                                {
                                    "label": "Select cIOS base:",
                                    "value": "56"
                                },
                                {
                                    "label": "Select cIOS slot:",
                                    "value": "249"
                                },
                                {
                                    "label": "Select cIOS revision:",
                                    "value": "65535"
                                }
                            ]
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_249.webp",
                            "alt": "Configurazione cIOS 249",
                            "caption": "Configurazione per cIOS 249"
                        },
                        {
                            "type": "text",
                            "content": "Premi <strong>A</strong> due volte e verifica che lo slot diventi verde."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Installa cIOS 250",
                    "blocks": [
                        {
                            "type": "settings-box",
                            "title": "Configurazione cIOS 250:",
                            "titleIcon": "bi-gear-fill",
                            "items": [
                                {
                                    "label": "Select cIOS:",
                                    "value": "d2x-v11-beta3"
                                },
                                {
                                    "label": "Select cIOS base:",
                                    "value": "57"
                                },
                                {
                                    "label": "Select cIOS slot:",
                                    "value": "250"
                                },
                                {
                                    "label": "Select cIOS revision:",
                                    "value": "65535"
                                }
                            ]
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_250.webp",
                            "alt": "Configurazione cIOS 250",
                            "caption": "Configurazione per cIOS 250"
                        },
                        {
                            "type": "text",
                            "content": "Premi <strong>A</strong> due volte e verifica che lo slot diventi verde."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Installa cIOS 251",
                    "blocks": [
                        {
                            "type": "settings-box",
                            "title": "Configurazione cIOS 251:",
                            "titleIcon": "bi-gear-fill",
                            "items": [
                                {
                                    "label": "Select cIOS:",
                                    "value": "d2x-v11-beta3"
                                },
                                {
                                    "label": "Select cIOS base:",
                                    "value": "58"
                                },
                                {
                                    "label": "Select cIOS slot:",
                                    "value": "251"
                                },
                                {
                                    "label": "Select cIOS revision:",
                                    "value": "65535"
                                }
                            ]
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/wii/modifica/steps/cios/screen_d2x_251.webp",
                            "alt": "Configurazione cIOS 251",
                            "caption": "Configurazione per cIOS 251"
                        },
                        {
                            "type": "text",
                            "content": "Premi <strong>A</strong> due volte e verifica che lo slot diventi verde."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Esci dall'installer",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Una volta completati tutti i <strong>4 cIOS</strong>, premi <strong>B</strong> per tornare all'Homebrew Channel."
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "titleIcon": "bi-info-circle-fill",
                            "content": "Puoi ora <strong>eliminare i 4 file WAD</strong> dalla tua SD/USB per liberare spazio — non servono più."
                        }
                    ]
                }
            ]
        },
        {
            "id": "conclusione",
            "title": "Conclusione",
            "icon": "bi-trophy-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "<strong>Complimenti!</strong> Hai completato la modifica della tua Wii! La tua console è ora completamente modificata con tutti gli strumenti essenziali installati."
                },
                {
                    "type": "summary",
                    "title": "Cosa hai installato",
                    "items": [
                        {
                            "icon": "bi-check-circle-fill",
                            "iconColor": "#4ade80",
                            "label": "Homebrew Channel",
                            "labelColor": "#4ade80",
                            "text": "Per avviare applicazioni homebrew"
                        },
                        {
                            "icon": "bi-check-circle-fill",
                            "iconColor": "#60a5fa",
                            "label": "BootMii + Backup NAND",
                            "labelColor": "#60a5fa",
                            "text": "Per backup e ripristino della memoria di sistema"
                        },
                        {
                            "icon": "bi-check-circle-fill",
                            "iconColor": "#c084fc",
                            "label": "Priiloader",
                            "labelColor": "#c084fc",
                            "text": "Protezione da brick e hacks del sistema"
                        },
                        {
                            "icon": "bi-check-circle-fill",
                            "iconColor": "#22d3ee",
                            "label": "cIOS (248, 249, 250, 251)",
                            "labelColor": "#22d3ee",
                            "text": "Per USB Loader, emulatori e funzionalità avanzate"
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Ricorda di conservare il backup NAND!",
                    "titleIcon": "bi-info-circle-fill",
                    "content": "Il backup NAND che hai creato con BootMii è il tuo <strong>\"salvavita\"</strong> in caso di problemi. Assicurati di conservarlo in un luogo sicuro (PC, cloud, hard disk esterno) e di non condividerlo con nessuno."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "E ora? Installa i giochi!",
                    "titleIcon": "bi-controller",
                    "content": "La modifica di base è completata! Ora puoi procedere con l'installazione dei giochi sulla tua Wii modificata.",
                    "cta": {
                        "label": "Guida Installazione Giochi",
                        "href": "/guide/wii/installazione-giochi",
                        "icon": "bi-arrow-right-circle-fill"
                    }
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Hai problemi o domande?",
                    "titleIcon": "bi-telegram",
                    "content": "Il nostro team è disponibile su Telegram per supportarti!",
                    "cta": {
                        "label": "Chiedi supporto su Telegram",
                        "href": "https://t.me/NintendoROMsGruppo",
                        "icon": "bi-telegram"
                    }
                }
            ]
        }
