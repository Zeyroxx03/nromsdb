    "sections": [
        {
            "id": "introduzione",
            "title": "Cos'è Wii Backup Manager?",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "<strong>Wii Backup Manager</strong> è un programma gratuito per <strong>Windows</strong> che ti permette di gestire, convertire e trasferire i backup dei giochi Wii su hard disk USB o chiavette. È lo strumento <strong>più comodo e sicuro</strong> per preparare i giochi da usare con USB Loader GX sulla Wii."
                },
                {
                    "type": "infobox",
                    "variant": "error",
                    "title": "Wii Modificata + cIOS Richiesti!",
                    "titleIcon": "bi-exclamation-octagon-fill",
                    "content": "Per poter <strong>giocare</strong> ai backup su Wii, ti serve una <strong>Wii modificata</strong> con Homebrew Channel, <strong>cIOS (d2x) installati</strong> e un <strong>USB Loader</strong> (come USB Loader GX). Se non hai ancora modificato la Wii, segui prima la <a href=\"/guide/wii/get-started\" data-route>guida alla modifica</a>."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Perché usare Wii Backup Manager?",
                    "titleIcon": "bi-lightbulb-fill",
                    "contentList": [
                        "Crea automaticamente la struttura cartelle corretta",
                        "Converte i file ISO in WBFS (risparmio spazio fino al 50%)",
                        "Rinomina i file con il formato corretto per USB Loader GX",
                        "Verifica che i giochi non siano corrotti",
                        "Scarica copertine e artwork automaticamente"
                    ]
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-clipboard-check-fill",
            "blocks": [
                {
                    "type": "two-columns",
                    "columns": [
                        {
                            "title": "Sul PC (Windows)",
                            "icon": "bi-pc-display",
                            "color": "#60a5fa",
                            "borderColor": "rgba(96,165,250,0.3)",
                            "items": [
                                "Windows 7/8/10/11",
                                ".NET Framework 4.0+ (solitamente già installato)",
                                "Wii Backup Manager (download sotto)",
                                "Giochi Wii in formato ISO o WBFS"
                            ]
                        },
                        {
                            "title": "Hardware Necessario",
                            "icon": "bi-hdd-fill",
                            "color": "#4ade80",
                            "borderColor": "rgba(74,222,128,0.3)",
                            "items": [
                                "Hard Disk USB o Chiavetta USB",
                                "Formattata in FAT32 (consigliato) o NTFS",
                                "Capacità minima: 8GB+ (consigliato 32GB+)"
                            ]
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "FAT32 consigliato",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "content": "Si consiglia di formattare l'USB in <strong>FAT32</strong> per la massima compatibilità con la Wii e USB Loader GX."
                }
            ]
        },
