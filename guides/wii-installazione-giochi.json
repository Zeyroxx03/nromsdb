        {
            "id": "installazione",
            "title": "Installazione e Configurazione",
            "icon": "bi-gear-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Estrai il file ZIP",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Estrai il contenuto del file <code>Wii-Backup-Manager.zip</code> in una cartella a tua scelta (es: <code>C:\\WiiBackupManager</code> o sul Desktop)."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Avvia il programma",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nella cartella estratta, troverai due versioni:"
                        },
                        {
                            "type": "list",
                            "items": [
                                {
                                    "icon": "bi-file-earmark-binary",
                                    "iconColor": "#4ade80",
                                    "html": "<code>WiiBackupManager_Win32.exe</code> — Per Windows a 32 bit"
                                },
                                {
                                    "icon": "bi-file-earmark-binary",
                                    "iconColor": "#60a5fa",
                                    "html": "<code>WiiBackupManager_Win64.exe</code> — Per Windows a 64 bit <strong>(consigliato)</strong>"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "content": "Avvia la versione appropriata per il tuo sistema (nel dubbio, prova la versione a 64 bit)."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Imposta la lingua italiana (opzionale)",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Per impostare l'italiano:"
                        },
                        {
                            "type": "settings-box",
                            "title": "Procedura:",
                            "titleIcon": "bi-translate",
                            "items": [
                                {
                                    "label": "1. Vai su:",
                                    "value": "Options (barra menu in alto)"
                                },
                                {
                                    "label": "2. Seleziona:",
                                    "value": "Language → Italiano"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "preparazione-usb",
            "title": "Preparazione USB",
            "icon": "bi-usb-symbol",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Attenzione!",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "content": "La formattazione <strong>cancellerà TUTTI i dati sull'USB!</strong> Fai backup di qualsiasi file importante prima di procedere."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Collega l'USB al PC",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Inserisci l'hard disk USB o la chiavetta nel PC."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Formatta in FAT32",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Per formattare in FAT32 (specialmente per USB oltre 32GB), usa <strong>guiformat</strong> o <strong>Rufus</strong>."
                        },
                        {
                            "type": "settings-box",
                            "title": "Impostazioni consigliate:",
                            "titleIcon": "bi-gear-fill",
                            "items": [
                                {
                                    "label": "File System:",
                                    "value": "FAT32"
                                },
                                {
                                    "label": "Allocation Unit Size:",
                                    "value": "32768 (32KB)"
                                },
                                {
                                    "label": "Volume Label:",
                                    "value": "WIIGAMES (o come preferisci)"
                                },
                                {
                                    "label": "Quick Format:",
                                    "value": "✓ Attivo"
                                }
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "USB oltre 32GB?",
                            "titleIcon": "bi-question-circle-fill",
                            "content": "Windows non permette di formattare USB oltre 32GB in FAT32 nativamente. Usa <strong>guiformat (FAT32 Format)</strong> o <strong>Rufus</strong> per aggirare questa limitazione."
                        }
                    ]
                }
            ]
        },
        {
            "id": "aggiungere-giochi",
            "title": "Aggiungere Giochi",
            "icon": "bi-plus-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Vai alla scheda \"Files\"",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "In Wii Backup Manager, clicca sulla scheda <strong>\"Files\"</strong> nella parte superiore della finestra."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Aggiungi i file dei giochi",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Hai due modi per aggiungere i giochi:"
                        },
                        {
                            "type": "two-columns",
                            "columns": [
                                {
                                    "title": "Metodo 1: Aggiungi file",
                                    "icon": "bi-file-earmark-plus",
                                    "color": "#4ade80",
                                    "borderColor": "rgba(74,222,128,0.3)",
                                    "items": [
                                        "Clicca su Files → Add → Files",
                                        "Seleziona i singoli file .iso o .wbfs"
                                    ]
                                },
                                {
                                    "title": "Metodo 2: Aggiungi cartella",
                                    "icon": "bi-folder-plus",
                                    "color": "#60a5fa",
                                    "borderColor": "rgba(96,165,250,0.3)",
                                    "items": [
                                        "Clicca su Files → Add → Folder",
                                        "Seleziona una cartella contenente più giochi"
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "content": "I giochi appariranno nella lista con titolo, ID, dimensione e altre informazioni."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Seleziona i giochi da trasferire",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Seleziona i giochi che vuoi copiare sull'USB:"
                        },
                        {
                            "type": "list",
                            "items": [
                                {
                                    "icon": "bi-check-square-fill",
                                    "iconColor": "#4ade80",
                                    "html": "<strong>Click singolo</strong> — Seleziona un gioco"
                                },
                                {
                                    "icon": "bi-check-square-fill",
                                    "iconColor": "#4ade80",
                                    "html": "<kbd>Ctrl</kbd> + <strong>Click</strong> — Seleziona più giochi"
                                },
                                {
                                    "icon": "bi-check-square-fill",
                                    "iconColor": "#4ade80",
                                    "html": "<kbd>Ctrl</kbd> + <kbd>A</kbd> — Seleziona tutti"
                                },
                                {
                                    "icon": "bi-check-square-fill",
                                    "iconColor": "#4ade80",
                                    "html": "<strong>Tasto destro → Select All</strong> — Seleziona tutti"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "trasferimento",
            "title": "Trasferimento su USB",
            "icon": "bi-arrow-right-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Vai alla scheda \"Drive 1\"",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca sulla scheda <strong>\"Drive 1\"</strong> (o \"Unità 1\") nella parte superiore. Questa scheda rappresenta la tua USB dove verranno copiati i giochi."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Seleziona l'unità USB",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Clicca su <strong>\"Drive\"</strong> (o \"Unità\") nel menu, poi <strong>\"Select Drive\"</strong> (Seleziona unità). Nella finestra che appare, seleziona la lettera della tua USB (es: <code>E:\\</code>, <code>F:\\</code>, ecc.) e clicca <strong>OK</strong>."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Trasferisci i giochi",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Torna alla scheda <strong>\"Files\"</strong>, seleziona i giochi da trasferire, poi:"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Per trasferire:",
                            "titleIcon": "bi-arrow-right-circle-fill",
                            "content": "<strong>Tasto destro</strong> sui giochi selezionati → <strong>Transfer → Drive 1</strong>. Oppure usa il pulsante nella toolbar: icona con freccia verso destra."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Attendi il completamento",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Apparirà una finestra di progresso. Il tempo dipende dalla dimensione dei giochi e dalla velocità USB."
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "title": "Cosa succede durante il trasferimento:",
                            "titleIcon": "bi-info-circle-fill",
                            "contentList": [
                                "✅ I giochi vengono convertiti in formato WBFS (se erano ISO)",
                                "✅ Viene creata automaticamente la cartella <code>wbfs</code>",
                                "✅ I file vengono rinominati con il formato corretto",
                                "✅ La struttura cartelle è pronta per USB Loader GX"
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Trasferimento completato!",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "L'USB ora contiene i tuoi giochi nel formato corretto. Puoi verificare andando nella scheda \"Drive 1\"."
                        }
                    ]
                }
            ]
        },
