                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Imposta dimensione emuMMC (RAW) a 29GB",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Vedrai una schermata con uno slider per impostare la dimensione della partizione emuMMC."
                        },
