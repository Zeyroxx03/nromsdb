        {
            "id": "troubleshooting",
            "title": "Risoluzione Problemi",
            "icon": "bi-tools",
            "blocks": [
                {
                    "type": "brick-list",
                    "title": "Problemi Comuni",
                    "items": [
                        {
                            "title": "Errore \"Failed to create partition\" durante partizionamento",
                            "desc": "SD card difettosa, non formattata correttamente o protezione da scrittura attiva. Soluzione: formatta la SD in FAT32 sul PC (Sezione 2) e riprova. Verifica che l'interruttore laterale non sia su Lock."
                        },
                        {
                            "title": "emuMMC creation bloccata al 0% o si ferma a metà",
                            "desc": "SD troppo lenta, difettosa o con settori corrotti. Attendi almeno 30 minuti. Se ancora bloccata, tieni premuto POWER per 12 secondi, riformatta la SD con GuiFormat e riparti dalla Parte 1."
                        },
                        {
                            "title": "Non vedo l'opzione \"Part 1\" quando creo emuMMC",
                            "desc": "Il partizionamento non è andato a buon fine. Torna in Tools → Partition SD Card, verifica di aver impostato emuMMC (RAW) a 29 FULL e riavvia il partizionamento. Attendi il messaggio \"Done!\" prima di procedere."
                        },
                        {
                            "title": "Errore \"Not enough space\" anche con SD da 64GB+",
                            "desc": "SD non formattata in FAT32 o con partizioni esistenti. Usa GuiFormat sul PC per formattare completamente in FAT32. Verifica che la SD sia realmente della dimensione dichiarata (alcune SD contraffatte mostrano capacità fake)."
                        },
                        {
                            "title": "emuMMC Status mostra \"Disabled\" dopo la creazione",
                            "desc": "emuMMC non attivata automaticamente. Nel menu emuMMC, tocca \"Change emuMMC\" → seleziona \"SD RAW 1\" → tocca \"OK\". Lo status dovrebbe cambiare in \"Enabled\"."
                        }
                    ]
                },
