{
    "id": "multi-desmume",
    "title": "Emulatore DS - DeSmuME",
    "subtitle": "Gioca ai titoli Nintendo DS sul tuo PC Windows",
    "icon": "bi-controller",
    "meta": {
        "tempo": "5-10 minuti",
        "difficolta": "Facile",
        "tipo": "Windows"
    },
    "breadcrumb": [
        { "label": "Home",           "href": "/",            "icon": "bi-house-fill" },
        { "label": "Guide",          "href": "/guide" },
        { "label": "Multi-Platform", "href": "/guide/multi" },
        { "label": "Emulatore DeSmuME" }
    ],
    "toc": [
        { "id": "introduzione",  "label": "Introduzione" },
        { "id": "requisiti",     "label": "Requisiti" },
