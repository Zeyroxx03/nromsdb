        { "id": "cambio-lingua", "label": "Modifica Lingua del Gioco" },
        { "id": "conclusione",   "label": "Conclusione" }
    ],
    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "hero-image",
                    "src": "/assets/guide/multi/pc/emulatore-desmume/desmume.webp",
                    "alt": "DeSmuME - Emulatore Nintendo DS",
                    "caption": "DeSmuME - L'emulatore Nintendo DS per PC"
                },
                {
                    "type": "text",
                    "content": "<strong>Vi do il benvenuto!</strong> In questa guida vedremo brevemente come <strong>giocare ai titoli Nintendo DS</strong> direttamente dal computer, tramite l'emulatore <strong>DeSmuME</strong>!"
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Cos'è DeSmuME?",
                    "titleIcon": "bi-lightbulb-fill",
                    "content": "<strong>DeSmuME</strong> è un emulatore <strong>open-source e gratuito</strong> per Nintendo DS. Permette di giocare a titoli DS (file <code>.nds</code>) su PC Windows, macOS e Linux con alta compatibilità e ottime prestazioni. Supporta salvataggi, cheat code, registrazione video e molto altro."
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-clipboard-check-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Requisiti necessari:",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "contentList": [
                        "💻 <strong>Un computer con Windows installato</strong> (Windows 7, 8, 10, 11)",
                        "🌐 <strong>Una connessione ad Internet</strong> (per scaricare i giochi dal canale roms)",
                        "📦 <strong>DeSmuME</strong> - Emulatore Nintendo DS",
                        "🎮 <strong>Roms .nds</strong> dei giochi che possiedi"
                    ]
                },
                {
                    "type": "download-list",
                    "title": "Download DeSmuME",
                    "titleIcon": "bi-download",
                    "items": [
                        {
                            "icon": "bi-github",
                            "iconColor": "#ffffff",
                            "label": "DeSmuME (GitHub Official)",
                            "desc": "Ultima versione ufficiale - Windows 64-bit",
                            "href": "https://github.com/TASEmulators/desmume/releases"
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "success",
                    "titleIcon": "bi-check-circle-fill",
                    "content": "DeSmuME è <strong>completamente gratuito</strong> e non richiede installazione! Basta estrarre e avviare l'eseguibile."
                }
            ]
        },
        {
            "id": "installazione",
            "title": "Installazione DeSmuME",
            "icon": "bi-gear-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Vediamo come scaricare, estrarre e avviare DeSmuME per la prima volta."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Scarica DeSmuME da GitHub",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dirigiamoci nella <a href=\"https://github.com/TASEmulators/desmume/releases\" target=\"_blank\" rel=\"noopener\">pagina di download ufficiale</a> dell'emulatore, linkata nei requisiti."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_desmume_evidenziato_github.webp",
                            "alt": "DeSmuME download GitHub",
                            "caption": "Pagina download DeSmuME su GitHub"
                        },
                        {
                            "type": "text",
                            "content": "Se possedete come sistema operativo <strong>Windows</strong>, selezionate il file evidenziato (es: <code>desmume-0.9.13-win64.zip</code>). Verrà scaricato automaticamente."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Estrai l'archivio ZIP",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Una volta scaricato, fai <strong>tasto destro</strong> sul file ZIP e seleziona <strong>\"Estrai qui\"</strong> (con WinRAR, 7-Zip o l'estrattore integrato di Windows)."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_evidenziato_estraiqui_winrar.webp",
                            "alt": "Estrazione DeSmuME con WinRAR",
                            "caption": "Estraiamo l'archivio con WinRAR o 7-Zip"
                        },
                        {
                            "type": "text",
                            "content": "Verrà immediatamente estratta la cartella contenente l'emulatore."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Apri la cartella e avvia DeSmuME",
                    "blocks": [
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_struttura_cartell_estratta.webp",
                            "alt": "Struttura cartella DeSmuME",
                            "caption": "Dirigiamoci all'interno della cartella, e apriamo l'applicazione evidenziata, ovvero il nostro emulatore"
                        },
                        {
                            "type": "text",
                            "content": "Fai <strong>doppio click</strong> sul file <strong>DeSmuME_0.9.13_x64.exe</strong> (o nome simile) per avviare l'emulatore."
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Se l'emulatore si apre correttamente, l'installazione è andata a buon fine!"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Apri una ROM",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dalla home principale dell'emulatore, vai su <strong>File → Open ROM..</strong>"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_desmume_file_openrom_evidenziati.webp",
                            "alt": "DeSmuME - File Open ROM",
                            "caption": "File → Open ROM.."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Seleziona il file del gioco",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Si aprirà una finestra di Esplora File. Naviga fino alla cartella dove hai salvato i tuoi giochi DS e seleziona il nostro gioco in formato <strong>.nds</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_esplorafile_file_gioco_evidenziato.webp",
                            "alt": "Selezione file .nds",
                            "caption": "Selezioniamo il file del gioco (.nds)"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 6,
                    "title": "Conferma l'apertura",
                    "blocks": [
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_apri_evidenziato_esplorafile.webp",
                            "alt": "Pulsante Apri evidenziato",
                            "caption": "E infine premiamo su \"Apri\""
                        },
                        {
                            "type": "text",
                            "content": "Clicca sul pulsante <strong>\"Apri\"</strong> per caricare il gioco."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 7,
                    "title": "Gioca!",
                    "blocks": [
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_desmume_gioco_aperto.webp",
                            "alt": "Gioco avviato in DeSmuME",
                            "caption": "E finalmente siamo sul nostro gioco!! Buon gameplay a tutti :)"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Perfetto!",
                            "titleIcon": "bi-trophy-fill",
                            "content": "Il gioco è ora in esecuzione. Usa la tastiera per giocare (o configura un controller nelle impostazioni)."
                        },
                        {
                            "type": "controls-box",
                            "title": "Controlli predefiniti:",
                            "titleIcon": "bi-keyboard-fill",
                            "controls": [
                                { "key": "Frecce direzionali", "action": "D-Pad" },
                                { "key": "X",                  "action": "Tasto A" },
                                { "key": "Z",                  "action": "Tasto B" },
                                { "key": "A",                  "action": "Tasto L" },
                                { "key": "S",                  "action": "Tasto R" },
                                { "key": "Invio",              "action": "Start" },
                                { "key": "Backspace",          "action": "Select" },
                                { "key": "Mouse",              "action": "Touch screen" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "cambio-lingua",
            "title": "Modifica Lingua del Gioco",
            "icon": "bi-translate",
            "blocks": [
                {
                    "type": "text",
                    "content": "La rom è europea ma il gioco risulta essere in <strong>lingua inglese</strong>? Nessun problema! Ecco la risoluzione che fa al caso tuo."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "titleIcon": "bi-info-circle-fill",
                    "content": "Questa procedura serve per impostare la lingua di sistema dell'emulatore. Molti giochi europei leggono questa impostazione e si avviano automaticamente nella lingua corretta."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Apri le impostazioni Firmware",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Con DeSmuME aperto, vai su <strong>Config → Firmware Settings</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_desmume_config_firmwaresetting.webp",
                            "alt": "DeSmuME - Config Firmware Settings",
                            "caption": "Config → Firmware Settings"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Cambia la lingua",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Si aprirà una finestra con le impostazioni del firmware DS emulato. Nel menu a tendina <strong>\"Language\"</strong>, seleziona <strong>\"Italian\"</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/multi/pc/emulatore-desmume/screen_firmwaresetting_language.webp",
                            "alt": "Firmware Settings - Language",
                            "caption": "Selezioniamo \"Italian\" dal menu Language"
                        },
                        {
                            "type": "text",
                            "content": "Dopo aver selezionato la lingua, clicca su <strong>\"OK\"</strong> per salvare le modifiche."
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "Salvate e giocate!",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Da ora in poi, i giochi che supportano l'italiano si avvieranno automaticamente in questa lingua."
                        },
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "title": "Nota:",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "Se hai già un gioco aperto, <strong>chiudilo e riaprilo</strong> affinché le modifiche abbiano effetto."
                        }
                    ]
                }
            ]
        },
        {
            "id": "conclusione",
            "title": "Conclusione",
            "icon": "bi-flag-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Complimenti! Hai installato e configurato con successo <strong>DeSmuME</strong>, l'emulatore Nintendo DS per PC. Ora sei pronto per giocare a tutti i tuoi titoli DS preferiti!"
                },
                
                {
                    "type": "two-columns",
                    "columns": [
                        {
                            "title": "Consigli Utili",
                            "icon": "bi-lightbulb-fill",
                            "color": "#60a5fa",
                            "borderColor": "rgba(96,165,250,0.3)",
                            "items": [
                                "Salva frequentemente: File → Save State",
                                "Configura i controlli: Config → Control Config",
                                "Aumenta la velocità: Config → Frame Skip"
                            ]
                        },
                        {
                            "title": "Funzionalità Extra",
                            "color": "#c084fc",
                            "borderColor": "rgba(192,132,252,0.3)",
                            "items": [
                                "Filtri grafici: Config → Display Method",
                                "Controller supportati: Xbox, PlayStation, Switch Pro",
                                "Backup salvataggi: File → Export Backup Memory",
                                "Cheat codes: Tools → Cheats"
                            ]
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Dove trovo i giochi DS?",
                    "titleIcon": "bi-joystick",
                    "content": "Puoi scaricare roms Nintendo DS dal nostro canale Telegram ufficiale. Ricorda: usa solo roms di giochi che possiedi fisicamente!",
                    "cta": {
                        "label": "Vai al Canale roms",
                        "href": "https://t.me/+VhTgmHwgmNk1NjY0",
                        "icon": "bi-telegram"
                    }
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Hai problemi o domande?",
                    "titleIcon": "bi-telegram",
                    "content": "Il nostro team è disponibile su Telegram per supportarti!",
                    "cta": {
                        "label": "Chiedi supporto su Telegram",
                        "href": "https://t.me/NintendoROMsGruppo",
                        "icon": "bi-telegram"
                    }
                }
            ]
        }
    ],
