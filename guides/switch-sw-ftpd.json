{
    "id": "switch-sw-ftpd",
    "title": "FTPD",
    "subtitle": "Trasferisci file via Wi-Fi tra PC e microSD della Switch",
    "icon": "bi-wifi",
    "meta": {
        "tempo": "5 minuti",
        "difficolta": "Facile",
        "tipo": "Wi-Fi"
    },
    "breadcrumb": [
        { "label": "Home", "href": "/", "icon": "bi-house-fill" },
        { "label": "Guide", "href": "/guide" },
        { "label": "Nintendo Switch", "href": "/guide/switch" },
        { "label": "FTPD" }
    ],
    "toc": [
        { "id": "introduzione", "label": "Introduzione" },
        { "id": "requisiti", "label": "Requisiti" },
        { "id": "utilizzo", "label": "Utilizzo" },
        { "id": "menu", "label": "Menu Principale" }
    ],
    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "<strong>FTPD</strong> è un server FTP per Nintendo Switch. Ti permette di trasferire file in modalita wireless da e verso la microSD, senza dover spegnere la console o rimuovere la scheda SD."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Quando usarlo?",
                    "titleIcon": "bi-wifi",
                    "content": "E utile per copiare homebrew, configurazioni, screenshot, salvataggi compatibili o file piccoli/medi direttamente tramite rete locale."
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti",
            "icon": "bi-clipboard-check-fill",
            "blocks": [
                {
                    "type": "list",
                    "items": [
                        { "icon": "bi-pc-display-horizontal", "iconColor": "#60a5fa", "html": "Un client FTP, ad esempio <strong>WinSCP</strong> su Windows." },
                        { "icon": "bi-router-fill", "iconColor": "#22d3ee", "html": "Un dispositivo capace di collegarsi a un server FTP tramite client FTP." },
                        { "icon": "bi-nintendo-switch", "iconColor": "#4ade80", "html": "Nintendo Switch modificata con accesso all'Homebrew Menu e app <strong>FTPD</strong> disponibile." }
                    ]
                }
            ]
        },
        {
            "id": "utilizzo",
            "title": "Utilizzo",
            "icon": "bi-arrow-left-right",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Stessa rete Wi-Fi",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "content": "Il dispositivo con il client FTP e la Switch devono essere collegati alla <strong>stessa rete</strong>. Se non lo sono, collegali alla stessa rete prima di continuare."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Avvia FTPD",
                    "blocks": [
                        { "type": "text", "content": "Apri l'app homebrew <strong>FTPD</strong> dall'Homebrew Menu della Switch." }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Apri il client FTP",
                    "blocks": [
                        { "type": "text", "content": "Sul PC o sul dispositivo che vuoi usare per trasferire i file, apri il client FTP che preferisci." }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Crea una nuova connessione",
                    "blocks": [
                        { "type": "text", "content": "Aggiungi una nuova connessione. Nel campo <strong>Host</strong> inserisci l'indirizzo IP mostrato in alto a sinistra dentro FTPD sulla Switch." },
                        { "type": "infobox", "variant": "info", "title": "Accesso anonimo", "titleIcon": "bi-person-check-fill", "content": "Se il tuo client FTP mostra l'opzione <strong>Anonymous</strong>, abilitala." }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Imposta la porta",
                    "blocks": [
                        { "type": "text", "content": "Nel campo <strong>Porta</strong> inserisci <code>5000</code>, poi prova a connetterti alla Switch." }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Trasferisci i file",
                    "blocks": [
                        { "type": "text", "content": "Una volta connesso, potrai accedere alla microSD via Wi-Fi e trasferire file da e verso la scheda." }
                    ]
                }
            ]
        },
        {
            "id": "menu",
            "title": "Menu Principale",
            "icon": "bi-window",
            "blocks": [
                {
                    "type": "text",
                    "content": "Questo e il menu principale di FTPD. In alto a sinistra trovi l'indirizzo IP della Switch da inserire nel client FTP."
                },
                {
                    "type": "image",
                    "src": "/assets/guide/switch/funz-aggiuntive/ftpd/ftpd_menu.webp",
                    "alt": "Menu principale di FTPD",
                    "caption": "Menu principale di FTPD"
                }
            ]
        }
    ],
