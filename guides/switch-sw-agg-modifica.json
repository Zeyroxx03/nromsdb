    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Quando seguire questa guida?",
                    "titleIcon": "bi-info-circle-fill",
                    "content": "Questa guida è necessaria <strong>solo se la tua Switch modificata non è aggiornata</strong> all'ultima versione di Atmosphere (1.11.1), Hekate (6.5.2) o Firmware (22.1.0). Se hai già tutto aggiornato, puoi saltare questa guida!"
                },
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Nota sugli screenshot",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "content": "Alcuni screenshot potrebbero mostrare versioni precedenti, ma <strong>tutti i pacchetti linkati sono aggiornati</strong> alle ultime versioni disponibili. Segui i passaggi come descritto!"
                },
                {
                    "type": "text",
                    "content": "In questa guida vedremo come <strong>aggiornare</strong> una Nintendo Switch già modificata alle ultime versioni di:"
                },
                {
                    "type": "spec-box",
                    "title": "Versioni Target",
                    "titleIcon": "bi-arrow-repeat",
                    "color": "#22d3ee",
                    "borderColor": "rgba(34,211,238,0.3)",
                    "items": [
                        { "icon": "bi-cloud-fill", "iconColor": "#22d3ee", "label": "Atmosphere CFW", "desc": "Versione 1.11.1" },
                        { "icon": "bi-hdd-rack-fill", "iconColor": "#60a5fa", "label": "Hekate Bootloader", "desc": "Versione 6.5.2" },
                        { "icon": "bi-display-fill", "iconColor": "#4ade80", "label": "Firmware Switch", "desc": "Versione 22.1.0" }
                    ]
                }
            ]
        },
        {
            "id": "requisiti",
            "title": "Requisiti — Download",
            "icon": "bi-download",
            "blocks": [
                {
                    "type": "text",
                    "content": "Scarica questi 3 file dal nostro canale Telegram Files:"
                },
                {
                    "type": "download-list",
                    "title": "File da Scaricare",
                    "titleIcon": "bi-telegram",
                    "items": [
                        {
                            "icon": "bi-pc-display",
                            "iconColor": "#60a5fa",
                            "label": "TegraRCMGUI v2.6",
                            "desc": "Tool per iniettare payload (solo se NON hai modchip)",
                            "href": "https://t.me/NintendoRomsFiles/18"
                        },
                        {
                            "icon": "bi-box-seam-fill",
                            "iconColor": "#c084fc",
                            "label": "Pack 22.1.0",
                            "desc": "Atmosphere 1.11.1 + Hekate 6.5.2 + Sigpatches + Homebrew",
                            "href": "https://t.me/NintendoROMsFiles/114"
                        },
                        {
                            "icon": "bi-hdd-fill",
                            "iconColor": "#4ade80",
                            "label": "Firmware 22.1.0",
                            "desc": "File firmware ufficiale per aggiornamento con Daybreak",
                            "href": "https://t.me/NintendoROMsFiles/112"
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-1",
            "title": "Parte 1 — Preparazione File",
            "icon": "bi-1-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Estrai il Pack 22.1.0",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Fai clic destro sul file ZIP scaricato → \"Estrai tutto...\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screenshot_cartella_unzippata_pack.webp",
                            "alt": "Cartella Pack 22.1.0 estratta",
                            "caption": "Contenuto del Pack 22.1.0 estratto"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Estrai il Firmware 22.1.0",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Estrai anche il file del firmware scaricato."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_cartella_fw_unzippata.webp",
                            "alt": "Cartella Firmware 22.1.0 estratta",
                            "caption": "Firmware 22.1.0 estratto"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Inserisci la microSD nel PC",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Rimuovi la microSD dalla Switch (console spenta) e inseriscila nel PC."
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-2",
            "title": "Parte 2 — Aggiornamento Atmosphere",
            "icon": "bi-2-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Copia la cartella Firmware sulla SD",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Prendi l'intera cartella <strong>\"Firmware 22.1.0\"</strong> estratta e copiala nella <strong>radice della microSD</strong>."
                        },
                        {
                            "type": "file-tree",
                            "title": "Struttura corretta",
                            "items": [
                                { "name": "microSD", "type": "drive", "depth": 0 },
                                { "name": "Firmware 22.1.0", "type": "folder", "depth": 1, "highlight": true, "last": true, "comment": "← Copia qui" }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Entra nella cartella Pack 22.1.0",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Apri la cartella estratta del Pack → Entra in <strong>\"Contenuto da mettere in SD (Nintendo Switch)\"</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_dentropack_evidenziata_cartella_contenutodamettereinsd.webp",
                            "alt": "Cartella Contenuto da mettere in SD evidenziata",
                            "caption": "Entra in \"Contenuto da mettere in SD (Nintendo Switch)\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Copia TUTTO il contenuto sulla SD",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Seleziona <strong>TUTTO</strong> il contenuto interno (<kbd>Ctrl+A</kbd>) e copialo nella <strong>radice della microSD</strong>. Sovrascrivi i file quando richiesto."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_tutto_spostato_in_sd.webp",
                            "alt": "Tutti i file copiati sulla microSD",
                            "caption": "Tutto il contenuto copiato nella radice della microSD"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Atmosphere e Hekate sono ora aggiornati sulla microSD!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-3",
            "title": "Parte 3 — Inject Hekate (Solo RCM)",
            "icon": "bi-3-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Console con modchip? Salta questa parte!",
                    "titleIcon": "bi-cpu-fill",
                    "content": "Se hai un <strong>modchip installato</strong>, accendi semplicemente la console normalmente. Il CFW si avvierà automaticamente. Salta alla <strong>Parte 4</strong>."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Installa TegraRCMGUI",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Installa <code>TegraRcmGUI_v2.6_Installer.msi</code> sul PC e avvialo."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Seleziona il payload Hekate aggiornato",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "In TegraRCMGUI, clicca sull'icona cartella per selezionare il payload."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_tegra_evidenziata_cartella_perselezionarepayload.webp",
                            "alt": "TegraRCMGUI selezione payload",
                            "caption": "Clicca sulla cartella per selezionare il payload"
                        },
                        {
                            "type": "text",
                            "content": "Vai nella cartella del Pack → <strong>Vari payloads (PC)</strong> → Seleziona <strong>hekate_ctcaer_6.5.2.bin</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_payloadhekate_evidenziato.webp",
                            "alt": "Payload Hekate 6.5.2 evidenziato",
                            "caption": "Seleziona hekate_ctcaer_6.5.2.bin"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Entra in RCM e inietta il payload",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Metti la Switch in modalità RCM (Jig + Volume+ e Power), collega il cavo USB-C al PC e clicca <strong>\"Inject payload\"</strong> in TegraRCMGUI."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_inject_payload_evidenziato.webp",
                            "alt": "Inject payload evidenziato",
                            "caption": "Clicca \"Inject payload\" per avviare Hekate"
                        },
                        {
                            "type": "infobox",
                            "variant": "info",
                            "titleIcon": "bi-info-circle-fill",
                            "content": "<strong>Ricorda:</strong> La Switch deve essere in RCM con il cavo USB-C collegato al PC!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-4",
            "title": "Parte 4 — Avvio Atmosphere Aggiornato",
            "icon": "bi-4-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Sei in Hekate 6.5.2!",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "La Switch dovrebbe mostrare il menu di Hekate aggiornato. Vai in <strong>\"Launch\"</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_hekate_home.webp",
                            "alt": "Menu HOME Hekate 6.5.2",
                            "caption": "Menu HOME di Hekate aggiornato"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Seleziona \"microSD CFW\"",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nel menu Launch, tocca <strong>\"microSD CFW\"</strong> per avviare Atmosphere emuMMC."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_menu_launch.webp",
                            "alt": "Menu Launch con microSD CFW evidenziato",
                            "caption": "Premi su \"microSD CFW\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Possibile errore Atmosphere (raro)",
                    "blocks": [
                        {
                            "type": "infobox",
                            "variant": "warning",
                            "title": "Errore all'avvio?",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "È possibile (ma non comune) che appaia un errore all'avvio di Atmosphere dopo l'aggiornamento."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_atmosphere_possibile_errore.webp",
                            "alt": "Possibile errore Atmosphere",
                            "caption": "Esempio di errore all'avvio (screenshot illustrativo)"
                        },
                        {
                            "type": "brick-list",
                            "title": "Soluzione all'errore:",
                            "items": [
                                {
                                    "title": "Cartella atmosphere corrotta",
                                    "desc": "Spegni la Switch → rimuovi la microSD → elimina la vecchia cartella atmosphere dalla SD → copia la nuova cartella atmosphere dal Pack 22.1.0 → reinserisci la SD e riavvia."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Atmosphere 1.11.1 avviato!",
                    "blocks": [
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_home_atmosphere.webp",
                            "alt": "Menu HOME Atmosphere",
                            "caption": "Menu HOME di Atmosphere caricato"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Verifica versione Atmosphere",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Vai in <strong>Impostazioni di sistema</strong> → <strong>Sistema</strong> → Scorri in fondo e verifica la <strong>Versione di sistema</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_imp_sistema_vers.webp",
                            "alt": "Versione sistema con Atmosphere 1.11.1",
                            "caption": "Verifica versione Atmosphere aggiornata"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "✅ Atmosphere, Hekate e Nyx aggiornati!",
                            "titleIcon": "bi-trophy-fill",
                            "content": "Dovresti vedere: <strong>|AMS 1.11.1|</strong> nella stringa di versione. Ora passiamo all'aggiornamento del firmware!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "parte-5",
            "title": "Parte 5 — Aggiornamento Firmware 22.1.0",
            "icon": "bi-5-circle-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Ora aggiorniamo il firmware dell'emuMMC alla versione 22.1.0 usando <strong>Daybreak</strong>, l'installer firmware ufficiale di Atmosphere."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Apri l'Album (Homebrew Menu)",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dal menu HOME, apri l'<strong>Album</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_home_atmosphere.webp",
                            "alt": "Album evidenziato nel menu HOME",
                            "caption": "Entra nell'Album"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Avvia Daybreak",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nel Homebrew Menu, scorri e seleziona <strong>Daybreak</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_album_daybreak_evidenziato.webp",
                            "alt": "Daybreak evidenziato nel Homebrew Menu",
                            "caption": "Avvia Daybreak"
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Installa il firmware con Daybreak",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Segui i passaggi nell'ordine mostrato:"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak1.webp",
                            "alt": "Daybreak - Seleziona Install",
                            "caption": "1. Seleziona \"Install\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak2.webp",
                            "alt": "Daybreak - Naviga alla cartella Firmware",
                            "caption": "2. Naviga alla cartella \"Firmware 22.1.0\" e premici"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak3.webp",
                            "alt": "Daybreak - Continue",
                            "caption": "3. Seleziona \"Continue\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak4.webp",
                            "alt": "Daybreak - Preserve settings",
                            "caption": "4. Seleziona \"Preserve settings\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak5.webp",
                            "alt": "Daybreak - Install FAT32 + exFAT",
                            "caption": "5. Premi su \"Install (FAT32 + exFAT)\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak6.webp",
                            "alt": "Daybreak - Conferma",
                            "caption": "6. Seleziona \"Continue\""
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak7.webp",
                            "alt": "Daybreak - Installazione in corso",
                            "caption": "7. Attendi il completamento — NON spegnere la console!"
                        },
                        {
                            "type": "infobox",
                            "variant": "error",
                            "titleIcon": "bi-exclamation-triangle-fill",
                            "content": "<strong>NON</strong> spegnere la console durante questo processo!"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/screen_daybreak8.webp",
                            "alt": "Daybreak - Completato",
                            "caption": "8. Seleziona \"Reboot\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Riavvia in Atmosphere",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dopo il reboot, ti ritroverai in Hekate. Vai in <strong>Launch → microSD CFW</strong> per avviare nuovamente Atmosphere."
                        }
                    ]
                }
            ]
        },
        {
            "id": "verifica-finale",
            "title": "Verifica Finale",
            "icon": "bi-check-circle-fill",
            "blocks": [
                {
                    "type": "step",
                    "number": 1,
                    "title": "Controlla la versione finale",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Vai in <strong>Impostazioni di sistema → Sistema</strong> e verifica la versione:"
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/funz-aggiuntive/aggiornamento-modifica/scren_imp_sistema_vers_aggiornata.webp",
                            "alt": "Versione sistema aggiornata 22.1.0",
                            "caption": "Versione sistema completa aggiornata"
                        },
                        {
                            "type": "file-listing",
                            "files": [
                                "22.1.0      ← Firmware Switch",
                                "|AMS 1.11.1| ← Atmosphere CFW",
                                "E           ← emuMMC"
                            ]
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "title": "✅ Aggiornamento Completato!",
                            "titleIcon": "bi-trophy-fill",
                            "content": "Tutto è aggiornato all'ultima versione! La tua Switch modificata è pronta per i nuovi giochi e funzionalità! 🎉"
                        }
                    ]
                }
            ]
        },
        {
            "id": "troubleshooting",
            "title": "Risoluzione Problemi",
            "icon": "bi-tools",
            "blocks": [
                {
                    "type": "brick-list",
                    "title": "Problemi Comuni",
                    "items": [
                        {
                            "title": "Daybreak non trova la cartella Firmware",
                            "desc": "La cartella \"Firmware 22.1.0\" è nella radice della SD? Hai estratto correttamente il file ZIP del firmware? Il nome della cartella è esatto (senza caratteri strani)?"
                        },
                        {
                            "title": "Errore durante l'installazione firmware",
                            "desc": "File firmware corrotti — ri-scarica il pack. SD card difettosa — prova un'altra SD. Spazio insufficiente — libera spazio sulla SD."
                        },
                        {
                            "title": "La console non si avvia dopo l'aggiornamento",
                            "desc": "Tieni premuto POWER per 12 secondi (spegnimento forzato) → rimuovi la SD e reinseriscila → riavvia in RCM e inietta nuovamente Hekate → se persiste, ricopia i file del Pack sulla SD."
                        }
                    ]
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Serve aiuto?",
                    "titleIcon": "bi-telegram",
                    "content": "Contattaci sul gruppo Telegram!",
                    "cta": {
                        "label": "Gruppo di Supporto",
                        "href": "https://t.me/NintendoROMsGruppo",
                        "icon": "bi-telegram"
                    }
                }
            ]
        }
    ],
