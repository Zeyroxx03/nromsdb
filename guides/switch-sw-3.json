{
    "id": "switch-sw-3",
    "title": "Sezione 3 — Preparazione SD Card",
    "subtitle": "Installiamo Atmosphere, Hekate e tutti i file necessari",
    "icon": "bi-folder-fill",
    "meta": {
        "tempo": "10-15 minuti",
        "difficolta": "Facile",
        "tipo": "PC Richiesto"
    },
    "breadcrumb": [
        { "label": "Home", "href": "/", "icon": "bi-house-fill" },
