{
    "id": "switch-sw-1",
    "title": "Sezione 1 — Aggiornamento Console",
    "subtitle": "Aggiorna Switch all'ultima versione firmware",
    "icon": "bi-arrow-repeat",
    "meta": {
        "tempo": "10-20 minuti",
        "difficolta": "Facile",
        "tipo": "Internet Richiesto"
    },
    "breadcrumb": [
        { "label": "Home", "href": "/", "icon": "bi-house-fill" },
        { "label": "Guide", "href": "/guide" },
        { "label": "Nintendo Switch", "href": "/guide/switch" },
        { "label": "Requisiti", "href": "/guide/switch/requisiti" },
        { "label": "Sezione 1" }
    ],
    "toc": [
        { "id": "introduzione", "label": "Introduzione" },
        { "id": "verifica-versione", "label": "Verifica Versione Attuale" },
        { "id": "procedura", "label": "Procedura di Aggiornamento" },
        { "id": "conclusione", "label": "Conclusione" }
    ],
    "sections": [
        {
            "id": "introduzione",
            "title": "Introduzione",
            "icon": "bi-info-circle-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "error",
                    "titleIcon": "bi-wifi",
                    "content": "<strong>Necessaria una connessione ad Internet!</strong> Questa sezione richiede che la tua Switch sia connessa a Internet per scaricare l'aggiornamento ufficiale da Nintendo."
                },
                {
                    "type": "text",
                    "content": "Una fase importante per questa modifica è avere la console <strong>aggiornata all'ultima versione</strong> disponibile, ovvero la <strong>22.1.0</strong> (ultima versione rilasciata da Nintendo il 7 aprile 2026)."
                },
                {
                    "type": "infobox",
                    "variant": "success",
                    "title": "Puoi saltare questa sezione se sei già all'ultima versione!",
                    "titleIcon": "bi-skip-forward-fill",
                    "content": "Se la tua Switch è già aggiornata alla versione <strong>22.1.0</strong>, puoi passare direttamente alla <a href=\"/guide/switch/sw-2\" data-route>Sezione 2 — Formattazione SD</a>."
                },
                {
                    "type": "sub-heading",
                    "title": "Perché è importante aggiornare?",
                    "icon": "bi-question-circle"
                },
                {
                    "type": "list",
                    "items": [
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Atmosphere supporta le ultime versioni</strong> — Il CFW è compatibile con il firmware più recente" },
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Maggiore compatibilità giochi</strong> — I giochi più recenti richiedono firmware aggiornato" },
                        { "icon": "bi-check-circle-fill", "iconColor": "#4ade80", "html": "<strong>Sicurezza</strong> — È meglio partire da una base aggiornata prima di modificare" }
                    ]
                }
            ]
        },
        {
            "id": "verifica-versione",
            "title": "Verifica Versione Attuale",
            "icon": "bi-search",
            "blocks": [
                {
                    "type": "text",
                    "content": "Prima di procedere, verifica quale versione firmware hai attualmente installato sulla tua Switch."
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Controlla la versione attuale",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Vai in: <strong>Impostazioni di Sistema → Console → Informazioni sulla console</strong>. Troverai la versione del sistema sotto \"Aggiornamento della console\"."
                        }
                    ]
                },
                {
                    "type": "table",
                    "title": "Versioni Firmware",
                    "titleIcon": "bi-list-check",
                    "headers": ["Versione", "Stato"],
                    "rows": [
                        { "cells": ["22.1.0", "✅ Ultima disponibile (Aprile 2026) — puoi saltare questa sezione"], "color": "#4ade80" },
                        { "cells": ["Versione precedente", "⚠️ Segui la guida per aggiornare"], "color": "#facc15" }
                    ]
                }
            ]
        },
        {
            "id": "procedura",
            "title": "Procedura di Aggiornamento",
            "icon": "bi-gear-fill",
            "blocks": [
                {
                    "type": "infobox",
                    "variant": "warning",
                    "title": "Prima di aggiornare:",
                    "titleIcon": "bi-exclamation-triangle-fill",
                    "contentList": [
                        "Assicurati che la Switch sia <strong>carica almeno al 50%</strong>",
                        "Connetti la Switch a una <strong>rete WiFi stabile</strong>",
                        "L'aggiornamento può richiedere <strong>10-20 minuti</strong>"
                    ]
                },
                {
                    "type": "step",
                    "number": 1,
                    "title": "Accedi alle Impostazioni di Sistema",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Accendi la console e dal menu HOME, premi sull'icona <strong>\"Impostazioni di sistema\"</strong> (l'ingranaggio in basso)."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/modifica/sezione1/screenshot-1-impostazioni-home.webp",
                            "alt": "Impostazioni di sistema Switch",
                            "caption": "Accendiamo la console e rechiamoci nelle \"Impostazioni di sistema\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 2,
                    "title": "Vai su Sistema",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "All'interno delle Impostazioni di sistema, <strong>scorri tutto in basso</strong> fino a trovare la voce <strong>\"Sistema\"</strong> e selezionala."
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 3,
                    "title": "Seleziona \"Aggiornamento della console\"",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Nel menu Sistema, premi su <strong>\"Aggiornamento della console\"</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/modifica/sezione1/screenshot-2-sistema-aggiornamento.webp",
                            "alt": "Menu Sistema - Aggiornamento della console",
                            "caption": "Scendiamo tutto in basso sino a \"Sistema\" e premiamo su \"Aggiornamento della console\""
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 4,
                    "title": "Avvia l'aggiornamento",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "La Switch verificherà automaticamente se sono disponibili aggiornamenti. Se disponibile, apparirà un pulsante <strong>\"Scarica\"</strong> o <strong>\"Aggiorna\"</strong>."
                        },
                        {
                            "type": "list",
                            "items": [
                                { "icon": "bi-arrow-right-circle-fill", "iconColor": "#60a5fa", "html": "Premi su <strong>\"Scarica\"</strong> per iniziare" },
                                { "icon": "bi-arrow-right-circle-fill", "iconColor": "#60a5fa", "html": "Attendi il completamento del download (può richiedere 5-15 minuti)" },
                                { "icon": "bi-arrow-right-circle-fill", "iconColor": "#60a5fa", "html": "La console si riavvierà automaticamente per installare l'aggiornamento" }
                            ]
                        }
                    ]
                },
                {
                    "type": "step",
                    "number": 5,
                    "title": "Verifica l'aggiornamento completato",
                    "blocks": [
                        {
                            "type": "text",
                            "content": "Dopo il riavvio, torna in <strong>Impostazioni → Sistema → Aggiornamento della console</strong> e verifica che la versione sia <strong>22.1.0</strong>."
                        },
                        {
                            "type": "image",
                            "src": "/assets/guide/switch/modifica/sezione1/screenshot-3-sistema-aggiornato-22-1-0.webp",
                            "alt": "Versione firmware 22.1.0",
                            "caption": "Questa è l'ultima versione rilasciata sino ad ora (22.1.0)"
                        },
                        {
                            "type": "infobox",
                            "variant": "success",
                            "titleIcon": "bi-check-circle-fill",
                            "content": "Se vedi <strong>\"La console è aggiornata\"</strong> e la versione <strong>22.1.0</strong>, sei pronto!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "conclusione",
            "title": "Conclusione",
            "icon": "bi-flag-fill",
            "blocks": [
                {
                    "type": "text",
                    "content": "Perfetto! Ora che la tua Switch è aggiornata all'ultima versione firmware, puoi procedere con la prossima sezione."
                },
                {
                    "type": "infobox",
                    "variant": "info",
                    "title": "Cosa succede ora?",
                    "titleIcon": "bi-lightbulb-fill",
                    "content": "Nella prossima sezione prepareremo la <strong>microSD card</strong>, formattandola correttamente in FAT32 per essere compatibile con il custom firmware Atmosphere."
                }
            ]
        }
    ],
